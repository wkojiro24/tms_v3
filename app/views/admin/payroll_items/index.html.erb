<% content_for :title, "給与項目グループ設定" %>
<% content_for :section_label, "管理者" %>

<div class="mb-3">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h5 class="mb-1">給与項目グループ設定</h5>
      <small class="text-muted">項目をドラッグ&ドロップでグループ間を移動・並べ替えできます。変更は自動保存されます。</small>
    </div>
    <div class="d-flex gap-2">
      <button type="button" class="btn btn-outline-secondary btn-sm" id="auto-assign-btn">
        <i class="bi bi-magic"></i> 自動分類
      </button>
      <%= link_to admin_payrolls_path, class: "btn btn-outline-primary btn-sm" do %>
        <i class="bi bi-arrow-left"></i> 給与グリッドへ戻る
      <% end %>
    </div>
  </div>
</div>

<div class="row" id="payroll-groups-container">
  <!-- 未設定 -->
  <div class="col-12 col-md-6 col-xl-3 mb-3">
    <div class="card h-100">
      <div class="card-header bg-secondary text-white py-2">
        <strong>未設定</strong>
        <span class="badge bg-light text-dark ms-2" id="count-unassigned"><%= @grouped_items[nil]&.size || 0 %></span>
      </div>
      <div class="card-body p-2 payroll-group-list" data-group="" id="group-unassigned" style="min-height: 150px; max-height: 350px; overflow-y: auto;">
        <% @grouped_items[nil]&.each do |item| %>
          <div class="payroll-item <%= 'payroll-item-hidden' if item.hidden? %>" data-item-id="<%= item.id %>" data-above-basic="<%= item.above_basic? %>">
            <i class="bi bi-grip-vertical text-muted me-2"></i>
            <span class="item-name"><%= item.name %></span>
            <% if item.above_basic? %><span class="badge bg-info ms-1">金額</span><% end %>
            <button type="button" class="btn btn-sm p-0 ms-auto toggle-hidden-btn" data-item-id="<%= item.id %>" title="<%= item.hidden? ? '表示する' : '非表示にする' %>">
              <i class="bi <%= item.hidden? ? 'bi-eye-slash text-danger' : 'bi-eye text-muted' %>"></i>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- 基本給 -->
  <div class="col-12 col-md-6 col-xl-3 mb-3">
    <div class="card h-100 border-success">
      <div class="card-header bg-success text-white py-2">
        <strong>基本給</strong>
        <span class="badge bg-light text-dark ms-2" id="count-base"><%= @grouped_items["base"]&.size || 0 %></span>
        <small class="ms-1 opacity-75">(小計あり)</small>
      </div>
      <div class="card-body p-2 payroll-group-list" data-group="base" id="group-base" style="min-height: 150px; max-height: 350px; overflow-y: auto;">
        <% @grouped_items["base"]&.each do |item| %>
          <div class="payroll-item payroll-item-base <%= 'payroll-item-hidden' if item.hidden? %>" data-item-id="<%= item.id %>" data-above-basic="<%= item.above_basic? %>">
            <i class="bi bi-grip-vertical text-muted me-2"></i>
            <span class="item-name"><%= item.name %></span>
            <% if item.above_basic? %><span class="badge bg-info ms-1">金額</span><% end %>
            <button type="button" class="btn btn-sm p-0 ms-auto toggle-hidden-btn" data-item-id="<%= item.id %>" title="<%= item.hidden? ? '表示する' : '非表示にする' %>">
              <i class="bi <%= item.hidden? ? 'bi-eye-slash text-danger' : 'bi-eye text-muted' %>"></i>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- 手当等 -->
  <div class="col-12 col-md-6 col-xl-3 mb-3">
    <div class="card h-100" style="border-color: #10b981;">
      <div class="card-header text-white py-2" style="background-color: #10b981;">
        <strong>手当等</strong>
        <span class="badge bg-light text-dark ms-2" id="count-allowance"><%= @grouped_items["allowance"]&.size || 0 %></span>
      </div>
      <div class="card-body p-2 payroll-group-list" data-group="allowance" id="group-allowance" style="min-height: 150px; max-height: 350px; overflow-y: auto;">
        <% @grouped_items["allowance"]&.each do |item| %>
          <div class="payroll-item payroll-item-allowance <%= 'payroll-item-hidden' if item.hidden? %>" data-item-id="<%= item.id %>" data-above-basic="<%= item.above_basic? %>">
            <i class="bi bi-grip-vertical text-muted me-2"></i>
            <span class="item-name"><%= item.name %></span>
            <% if item.above_basic? %><span class="badge bg-info ms-1">金額</span><% end %>
            <button type="button" class="btn btn-sm p-0 ms-auto toggle-hidden-btn" data-item-id="<%= item.id %>" title="<%= item.hidden? ? '表示する' : '非表示にする' %>">
              <i class="bi <%= item.hidden? ? 'bi-eye-slash text-danger' : 'bi-eye text-muted' %>"></i>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- 変動給 -->
  <div class="col-12 col-md-6 col-xl-3 mb-3">
    <div class="card h-100 border-primary">
      <div class="card-header bg-primary text-white py-2">
        <strong>変動給</strong>
        <span class="badge bg-light text-dark ms-2" id="count-variable"><%= @grouped_items["variable"]&.size || 0 %></span>
      </div>
      <div class="card-body p-2 payroll-group-list" data-group="variable" id="group-variable" style="min-height: 150px; max-height: 350px; overflow-y: auto;">
        <% @grouped_items["variable"]&.each do |item| %>
          <div class="payroll-item payroll-item-variable <%= 'payroll-item-hidden' if item.hidden? %>" data-item-id="<%= item.id %>" data-above-basic="<%= item.above_basic? %>">
            <i class="bi bi-grip-vertical text-muted me-2"></i>
            <span class="item-name"><%= item.name %></span>
            <% if item.above_basic? %><span class="badge bg-info ms-1">金額</span><% end %>
            <button type="button" class="btn btn-sm p-0 ms-auto toggle-hidden-btn" data-item-id="<%= item.id %>" title="<%= item.hidden? ? '表示する' : '非表示にする' %>">
              <i class="bi <%= item.hidden? ? 'bi-eye-slash text-danger' : 'bi-eye text-muted' %>"></i>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- 変動給算出根拠 -->
  <div class="col-12 col-md-6 col-xl-3 mb-3">
    <div class="card h-100 border-warning">
      <div class="card-header bg-warning text-dark py-2">
        <strong>変動給算出根拠</strong>
        <span class="badge bg-dark text-light ms-2" id="count-variable_basis"><%= @grouped_items["variable_basis"]&.size || 0 %></span>
      </div>
      <div class="card-body p-2 payroll-group-list" data-group="variable_basis" id="group-variable_basis" style="min-height: 150px; max-height: 350px; overflow-y: auto;">
        <% @grouped_items["variable_basis"]&.each do |item| %>
          <div class="payroll-item payroll-item-variable_basis <%= 'payroll-item-hidden' if item.hidden? %>" data-item-id="<%= item.id %>" data-above-basic="<%= item.above_basic? %>">
            <i class="bi bi-grip-vertical text-muted me-2"></i>
            <span class="item-name"><%= item.name %></span>
            <% if item.above_basic? %><span class="badge bg-info ms-1">金額</span><% end %>
            <button type="button" class="btn btn-sm p-0 ms-auto toggle-hidden-btn" data-item-id="<%= item.id %>" title="<%= item.hidden? ? '表示する' : '非表示にする' %>">
              <i class="bi <%= item.hidden? ? 'bi-eye-slash text-danger' : 'bi-eye text-muted' %>"></i>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- 通勤費等補助 -->
  <div class="col-12 col-md-6 col-xl-3 mb-3">
    <div class="card h-100 border-info">
      <div class="card-header bg-info text-white py-2">
        <strong>通勤費等補助</strong>
        <span class="badge bg-light text-dark ms-2" id="count-commute"><%= @grouped_items["commute"]&.size || 0 %></span>
      </div>
      <div class="card-body p-2 payroll-group-list" data-group="commute" id="group-commute" style="min-height: 150px; max-height: 350px; overflow-y: auto;">
        <% @grouped_items["commute"]&.each do |item| %>
          <div class="payroll-item payroll-item-commute <%= 'payroll-item-hidden' if item.hidden? %>" data-item-id="<%= item.id %>" data-above-basic="<%= item.above_basic? %>">
            <i class="bi bi-grip-vertical text-muted me-2"></i>
            <span class="item-name"><%= item.name %></span>
            <% if item.above_basic? %><span class="badge bg-info ms-1">金額</span><% end %>
            <button type="button" class="btn btn-sm p-0 ms-auto toggle-hidden-btn" data-item-id="<%= item.id %>" title="<%= item.hidden? ? '表示する' : '非表示にする' %>">
              <i class="bi <%= item.hidden? ? 'bi-eye-slash text-danger' : 'bi-eye text-muted' %>"></i>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- 福利厚生 -->
  <div class="col-12 col-md-6 col-xl-3 mb-3">
    <div class="card h-100" style="border-color: #9c27b0;">
      <div class="card-header text-white py-2" style="background-color: #9c27b0;">
        <strong>福利厚生</strong>
        <span class="badge bg-light text-dark ms-2" id="count-welfare"><%= @grouped_items["welfare"]&.size || 0 %></span>
      </div>
      <div class="card-body p-2 payroll-group-list" data-group="welfare" id="group-welfare" style="min-height: 150px; max-height: 350px; overflow-y: auto;">
        <% @grouped_items["welfare"]&.each do |item| %>
          <div class="payroll-item payroll-item-welfare <%= 'payroll-item-hidden' if item.hidden? %>" data-item-id="<%= item.id %>" data-above-basic="<%= item.above_basic? %>">
            <i class="bi bi-grip-vertical text-muted me-2"></i>
            <span class="item-name"><%= item.name %></span>
            <% if item.above_basic? %><span class="badge bg-info ms-1">金額</span><% end %>
            <button type="button" class="btn btn-sm p-0 ms-auto toggle-hidden-btn" data-item-id="<%= item.id %>" title="<%= item.hidden? ? '表示する' : '非表示にする' %>">
              <i class="bi <%= item.hidden? ? 'bi-eye-slash text-danger' : 'bi-eye text-muted' %>"></i>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- 税金・社会保険 -->
  <div class="col-12 col-md-6 col-xl-3 mb-3">
    <div class="card h-100 border-danger">
      <div class="card-header bg-danger text-white py-2">
        <strong>税金・社会保険</strong>
        <span class="badge bg-light text-dark ms-2" id="count-tax_insurance"><%= @grouped_items["tax_insurance"]&.size || 0 %></span>
      </div>
      <div class="card-body p-2 payroll-group-list" data-group="tax_insurance" id="group-tax_insurance" style="min-height: 150px; max-height: 350px; overflow-y: auto;">
        <% @grouped_items["tax_insurance"]&.each do |item| %>
          <div class="payroll-item payroll-item-tax_insurance <%= 'payroll-item-hidden' if item.hidden? %>" data-item-id="<%= item.id %>" data-above-basic="<%= item.above_basic? %>">
            <i class="bi bi-grip-vertical text-muted me-2"></i>
            <span class="item-name"><%= item.name %></span>
            <% if item.above_basic? %><span class="badge bg-info ms-1">金額</span><% end %>
            <button type="button" class="btn btn-sm p-0 ms-auto toggle-hidden-btn" data-item-id="<%= item.id %>" title="<%= item.hidden? ? '表示する' : '非表示にする' %>">
              <i class="bi <%= item.hidden? ? 'bi-eye-slash text-danger' : 'bi-eye text-muted' %>"></i>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- その他 -->
  <div class="col-12 col-md-6 col-xl-3 mb-3">
    <div class="card h-100">
      <div class="card-header bg-dark text-white py-2">
        <strong>その他</strong>
        <span class="badge bg-light text-dark ms-2" id="count-other"><%= @grouped_items["other"]&.size || 0 %></span>
      </div>
      <div class="card-body p-2 payroll-group-list" data-group="other" id="group-other" style="min-height: 150px; max-height: 350px; overflow-y: auto;">
        <% @grouped_items["other"]&.each do |item| %>
          <div class="payroll-item payroll-item-other <%= 'payroll-item-hidden' if item.hidden? %>" data-item-id="<%= item.id %>" data-above-basic="<%= item.above_basic? %>">
            <i class="bi bi-grip-vertical text-muted me-2"></i>
            <span class="item-name"><%= item.name %></span>
            <% if item.above_basic? %><span class="badge bg-info ms-1">金額</span><% end %>
            <button type="button" class="btn btn-sm p-0 ms-auto toggle-hidden-btn" data-item-id="<%= item.id %>" title="<%= item.hidden? ? '表示する' : '非表示にする' %>">
              <i class="bi <%= item.hidden? ? 'bi-eye-slash text-danger' : 'bi-eye text-muted' %>"></i>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- 保存状態インジケーター -->
<div id="save-indicator" class="position-fixed bottom-0 end-0 m-3 d-none">
  <div class="alert alert-success py-2 px-3 mb-0 d-flex align-items-center">
    <i class="bi bi-check-circle me-2"></i>
    <span>保存しました</span>
  </div>
</div>

<style>
.payroll-item {
  display: flex;
  align-items: center;
  padding: 6px 8px;
  margin-bottom: 3px;
  background: #fff;
  border: 1px solid #dee2e6;
  border-radius: 4px;
  cursor: grab;
  font-size: 0.8rem;
  transition: all 0.15s;
}
.payroll-item:hover { background: #f8f9fa; border-color: #adb5bd; }
.payroll-item.sortable-ghost { opacity: 0.4; background: #e9ecef; }
.payroll-item.sortable-chosen { box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
.payroll-item-base { border-left: 3px solid #198754; }
.payroll-item-allowance { border-left: 3px solid #10b981; }
.payroll-item-variable { border-left: 3px solid #0d6efd; }
.payroll-item-variable_basis { border-left: 3px solid #ffc107; }
.payroll-item-commute { border-left: 3px solid #0dcaf0; }
.payroll-item-welfare { border-left: 3px solid #9c27b0; }
.payroll-item-tax_insurance { border-left: 3px solid #dc3545; }
.payroll-item-other { border-left: 3px solid #6c757d; }
.payroll-group-list { background: #f8f9fa; border-radius: 4px; }
.payroll-item-hidden { opacity: 0.5; background: #f0f0f0; }
.payroll-item-hidden .item-name { text-decoration: line-through; }
.toggle-hidden-btn { background: none; border: none; cursor: pointer; }
.toggle-hidden-btn:hover { opacity: 0.7; }
</style>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
  const saveIndicator = document.getElementById('save-indicator');
  let saveTimeout;

  function showSaveIndicator() {
    saveIndicator.classList.remove('d-none');
    clearTimeout(saveTimeout);
    saveTimeout = setTimeout(() => saveIndicator.classList.add('d-none'), 2000);
  }

  function updateCounts() {
    document.querySelectorAll('.payroll-group-list').forEach(list => {
      const group = list.dataset.group || 'unassigned';
      const count = list.querySelectorAll('.payroll-item').length;
      const countEl = document.getElementById('count-' + group);
      if (countEl) countEl.textContent = count;
    });
  }

  function updateItemStyle(item, group) {
    item.className = 'payroll-item';
    if (group) item.classList.add('payroll-item-' + group);
  }

  function saveReorder(list) {
    const group = list.dataset.group;
    const items = Array.from(list.querySelectorAll('.payroll-item')).map(el => el.dataset.itemId);
    fetch('<%= reorder_admin_payroll_items_path %>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
      body: JSON.stringify({ group: group, items: items })
    })
    .then(r => r.json())
    .then(data => { if (data.success) { showSaveIndicator(); updateCounts(); } })
    .catch(err => console.error('Save error:', err));
  }

  document.querySelectorAll('.payroll-group-list').forEach(list => {
    new Sortable(list, {
      group: 'payroll-items',
      animation: 150,
      ghostClass: 'sortable-ghost',
      chosenClass: 'sortable-chosen',
      onEnd: function(evt) {
        updateItemStyle(evt.item, evt.to.dataset.group);
        saveReorder(evt.to);
        if (evt.from !== evt.to) updateCounts();
      }
    });
  });

  // 非表示トグル
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('.toggle-hidden-btn');
    if (!btn) return;
    e.preventDefault();
    const itemId = btn.dataset.itemId;
    const item = btn.closest('.payroll-item');

    fetch('/admin/payroll_items/' + itemId + '/toggle_hidden', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken }
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        const icon = btn.querySelector('i');
        if (data.hidden) {
          item.classList.add('payroll-item-hidden');
          icon.className = 'bi bi-eye-slash text-danger';
          btn.title = '表示する';
        } else {
          item.classList.remove('payroll-item-hidden');
          icon.className = 'bi bi-eye text-muted';
          btn.title = '非表示にする';
        }
        showSaveIndicator();
      }
    })
    .catch(err => console.error('Toggle error:', err));
  });

  // 自動分類（ユーザー指定のリストに基づく）
  document.getElementById('auto-assign-btn').addEventListener('click', function() {
    // 算定根拠（above_basic=false のみ）
    const variableBasisItems = [
      '平日出勤日数', '法定休日', '法定外休日', '代休日数', '有休日数', '欠勤日数',
      '就労時間', '平日残業', '法定休日時間', '法定外休時間', '法定代休時間',
      '法定外代時間', '割増残業', '有給休暇時間', '深夜残業', '有休残日数', '税額表', '扶養人数'
    ];

    // 基本給
    const baseItems = [
      '基本給', '職位加算', '職責加算', '調整給', '呼出手当', '基本給2',
      '無事故報奨金', '無事故加算', '有給休暇', '調整加算', '欠勤控除', '大都市加算'
    ];

    // 変動費（above_basic=true のみ）
    const variableItems = [
      '平日残業', '法定休日残業', '法定外休日残', '法定代休残業', '法定外代休残', '割増残業', '深夜残業'
    ];

    const unassignedList = document.getElementById('group-unassigned');
    const itemsToMove = [];

    unassignedList.querySelectorAll('.payroll-item').forEach(item => {
      const name = item.querySelector('.item-name').textContent.trim();
      const isAboveBasic = item.dataset.aboveBasic === 'true';
      let targetGroup = null;

      // 基本給（リスト完全一致）
      if (baseItems.includes(name)) {
        targetGroup = 'base';
      }
      // 変動費（above_basic=true かつリストに含まれる）
      else if (isAboveBasic && variableItems.includes(name)) {
        targetGroup = 'variable';
      }
      // 算定根拠（above_basic=false かつリストに含まれる）
      else if (!isAboveBasic && variableBasisItems.includes(name)) {
        targetGroup = 'variable_basis';
      }

      if (targetGroup) {
        const targetList = document.getElementById('group-' + targetGroup);
        if (targetList) itemsToMove.push({ item, targetList, group: targetGroup });
      }
    });

    itemsToMove.forEach(({ item, targetList, group }) => {
      updateItemStyle(item, group);
      targetList.appendChild(item);
    });

    document.querySelectorAll('.payroll-group-list').forEach(list => saveReorder(list));
    updateCounts();
  });
});
</script>
