<%= form_with model: [:admin, @bookmark], class: "needs-validation", novalidate: true do |f| %>
  <div class="row">
    <div class="col-lg-8">
      <div class="card card-lift shadow-sm mb-4">
        <div class="card-header bg-white">
          <h6 class="mb-0">基本情報</h6>
        </div>
        <div class="card-body">
          <% if @bookmark.errors.any? %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% @bookmark.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= f.label :title, "タイトル", class: "form-label" %>
            <%= f.text_field :title, class: "form-control", required: true, placeholder: "例: 国土交通省" %>
          </div>

          <div class="mb-3">
            <%= f.label :url, "URL", class: "form-label" %>
            <%= f.url_field :url, class: "form-control", required: true, placeholder: "https://..." %>
          </div>

          <div class="mb-3">
            <%= f.label :description, "説明", class: "form-label" %>
            <%= f.text_area :description, class: "form-control", rows: 2, placeholder: "リンクの説明（任意）" %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card card-lift shadow-sm mb-4">
        <div class="card-header bg-white">
          <h6 class="mb-0">設定</h6>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <%= f.label :category, "カテゴリ", class: "form-label" %>
            <%= f.select :category, Bookmark::CATEGORIES.map { |k, v| [v, k] }, {}, class: "form-select" %>
          </div>

          <div class="mb-3">
            <%= f.label :icon, "アイコン", class: "form-label" %>
            <%= f.select :icon, Bookmark::ICONS.map { |k, v| [k.capitalize, k] }, {}, class: "form-select" %>
            <small class="text-muted">プレビュー: <i class="bi <%= @bookmark.icon_class %>" id="icon-preview"></i></small>
          </div>

          <div class="mb-3">
            <%= f.label :position, "表示順", class: "form-label" %>
            <%= f.number_field :position, class: "form-control", min: 0, placeholder: "小さい数字が先に表示" %>
          </div>

          <div class="form-check">
            <%= f.check_box :shared, class: "form-check-input" %>
            <%= f.label :shared, "全員に公開", class: "form-check-label" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit @bookmark.persisted? ? "更新" : "作成", class: "btn btn-primary" %>
    <%= link_to "キャンセル", admin_bookmarks_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const iconSelect = document.querySelector('select[name="bookmark[icon]"]');
    const iconPreview = document.getElementById('icon-preview');
    const iconMap = <%= raw Bookmark::ICONS.to_json %>;

    if (iconSelect && iconPreview) {
      iconSelect.addEventListener('change', function() {
        iconPreview.className = 'bi ' + (iconMap[this.value] || 'bi-link-45deg');
      });
    }
  });
</script>
