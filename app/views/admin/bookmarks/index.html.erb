<% content_for :title, "ブックマーク管理" %>
<% content_for :section_label, "管理者" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0">ブックマーク管理</h4>
  <%= link_to new_admin_bookmark_path, class: "btn btn-primary" do %>
    <i class="bi bi-plus-lg me-1"></i>新規作成
  <% end %>
</div>

<div class="card card-lift shadow-sm">
  <div class="card-body p-0">
    <% if @bookmarks.any? %>
      <% Bookmark::CATEGORIES.each do |key, label| %>
        <% bookmarks_in_category = @bookmarks_by_category[key] || [] %>
        <% if bookmarks_in_category.any? %>
          <div class="border-bottom">
            <div class="px-3 py-2 bg-light">
              <strong><%= label %></strong>
              <span class="badge bg-secondary ms-1"><%= bookmarks_in_category.size %></span>
            </div>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <tbody>
                  <% bookmarks_in_category.each do |bookmark| %>
                    <tr>
                      <td width="40" class="text-center">
                        <i class="bi <%= bookmark.icon_class %> text-primary"></i>
                      </td>
                      <td>
                        <div class="d-flex align-items-center gap-2">
                          <%= link_to bookmark.title, bookmark.url, target: "_blank", class: "text-decoration-none fw-medium" %>
                          <% unless bookmark.shared? %>
                            <span class="badge bg-secondary">非公開</span>
                          <% end %>
                        </div>
                        <% if bookmark.description.present? %>
                          <small class="text-muted"><%= bookmark.description %></small>
                        <% end %>
                        <small class="text-muted d-block"><%= bookmark.domain %></small>
                      </td>
                      <td width="120">
                        <div class="btn-group btn-group-sm">
                          <%= link_to edit_admin_bookmark_path(bookmark), class: "btn btn-outline-primary" do %>
                            <i class="bi bi-pencil"></i>
                          <% end %>
                          <%= button_to admin_bookmark_path(bookmark), method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "「#{bookmark.title}」を削除しますか？" } do %>
                            <i class="bi bi-trash"></i>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <div class="text-center text-muted py-5">
        <i class="bi bi-bookmark fs-1 d-block mb-3"></i>
        ブックマークがありません
        <div class="mt-3">
          <%= link_to "新規作成", new_admin_bookmark_path, class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
