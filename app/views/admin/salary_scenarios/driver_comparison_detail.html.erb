<% content_for :title, "個人給与比較" %>
<% content_for :section_label, "給与シミュレーター" %>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <%= link_to driver_comparison_admin_salary_scenarios_path, class: "btn btn-outline-secondary btn-sm mb-2" do %>
      <i class="bi bi-arrow-left"></i> 一覧に戻る
    <% end %>
    <h5 class="mb-0">個人給与比較</h5>
    <small class="text-muted">現行と新給与体系の詳細比較（社会保険・会社負担含む）</small>
  </div>
</div>

<!-- 従業員選択・パラメータ設定 -->
<div class="card mb-3">
  <div class="card-header py-2">
    <strong><i class="bi bi-person me-1"></i> 対象者・パラメータ設定</strong>
  </div>
  <div class="card-body py-3">
    <%= form_tag driver_comparison_detail_calculate_admin_salary_scenarios_path, method: :post, class: "row g-3" do %>
      <!-- 従業員選択 -->
      <div class="col-md-4">
        <label class="form-label fw-bold small mb-1">従業員</label>
        <%= select_tag :employee_id,
            options_from_collection_for_select(@employees, :id, ->(e) { "#{e.employee_code} #{e.full_name}" }, @employee.id),
            class: "form-select form-select-sm" %>
      </div>

      <!-- 等級選択 -->
      <%
        # 現行の基本給から等級を推定
        current_base = @comparison[:current][:fixed][:base_salary]
        current_grade = case current_base
                        when 0..184_999 then 1
                        when 185_000..194_999 then 2
                        when 195_000..204_999 then 3
                        when 205_000..214_999 then 4
                        else 5
                        end
        grade_options = (1..5).map do |g|
          amount = @params[:"base_salary_#{g}"]
          label = "#{g}級 (#{number_with_delimiter(amount)}円)"
          label += " ◀現行" if g == current_grade
          [label, g]
        end
      %>
      <div class="col-md-2">
        <label class="form-label fw-bold small mb-1">基本給等級</label>
        <%= select_tag :selected_grade,
            options_for_select(grade_options, @comparison[:proposed][:fixed][:selected_grade]),
            class: "form-select form-select-sm" %>
      </div>

      <!-- 無事故状態選択 -->
      <%
        current_safety = @comparison[:current][:fixed][:safety_bonus]
        current_safety_status = if current_safety == 0
                                  "none"
                                elsif current_safety >= @params[:safety_one_year]
                                  "one_year"
                                else
                                  "half_year"
                                end
        safety_options = [
          ["1年以上 (#{number_with_delimiter(@params[:safety_one_year])}円)#{current_safety_status == 'one_year' ? ' ◀現行' : ''}", "one_year"],
          ["半年以上 (#{number_with_delimiter(@params[:safety_half_year])}円)#{current_safety_status == 'half_year' ? ' ◀現行' : ''}", "half_year"],
          ["事故1回後 (#{number_with_delimiter(@params[:safety_half_year])}円)", "accident_once"],
          ["なし (0円)#{current_safety_status == 'none' ? ' ◀現行' : ''}", "none"]
        ]
      %>
      <div class="col-md-3">
        <label class="form-label fw-bold small mb-1">無事故手当</label>
        <%= select_tag :selected_safety,
            options_for_select(safety_options, @comparison[:proposed][:fixed][:selected_safety]),
            class: "form-select form-select-sm" %>
      </div>

      <!-- 難易度選択 -->
      <div class="col-md-3">
        <label class="form-label fw-bold small mb-1">難易度給</label>
        <%= select_tag :selected_difficulty,
            options_for_select([
              ["高 (#{number_with_delimiter(@params[:difficulty_high])}円) トレーラー・重油", "high"],
              ["中 (#{number_with_delimiter(@params[:difficulty_mid])}円) 苛性ソーダ等", "mid"],
              ["低 (#{number_with_delimiter(@params[:difficulty_low])}円) 硫酸バンド等", "low"],
              ["なし (0円)", "none"]
            ], @comparison[:proposed][:fixed][:selected_difficulty]),
            class: "form-select form-select-sm" %>
      </div>

      <!-- 職位・職責 -->
      <%
        current_position = @comparison[:current][:fixed][:position]
        current_role = @comparison[:current][:fixed][:role]
        position_options = [
          ["なし (0円)#{current_position == 0 ? ' ◀現行' : ''}", 0],
          ["副班長 (3,000円)#{current_position == 3000 ? ' ◀現行' : ''}", 3000],
          ["班長 (5,000円)#{current_position == 5000 ? ' ◀現行' : ''}", 5000]
        ]
        role_options = [
          ["なし (0円)#{current_role == 0 ? ' ◀現行' : ''}", 0],
          ["衛生管理者 (5,000円)#{current_role == 5000 ? ' ◀現行' : ''}", 5000],
          ["整備管理者 (10,000円)#{current_role == 10000 ? ' ◀現行' : ''}", 10000],
          ["運行管理者 (15,000円)#{current_role == 15000 ? ' ◀現行' : ''}", 15000]
        ]
      %>
      <div class="col-md-2">
        <label class="form-label fw-bold small mb-1">職位加算</label>
        <%= select_tag :position_allowance,
            options_for_select(position_options, @comparison[:proposed][:fixed][:position]),
            class: "form-select form-select-sm" %>
      </div>
      <div class="col-md-2">
        <label class="form-label fw-bold small mb-1">職責加算</label>
        <%= select_tag :role_allowance,
            options_for_select(role_options, @comparison[:proposed][:fixed][:role]),
            class: "form-select form-select-sm" %>
      </div>

      <!-- 残業時間・深夜時間 -->
      <div class="col-md-2">
        <label class="form-label fw-bold small mb-1">残業時間</label>
        <div class="input-group input-group-sm">
          <%= number_field_tag :overtime_hours, @comparison[:attendance][:overtime_hours], class: "form-control form-control-sm text-end", step: "any", min: 0, id: "overtime_hours" %>
          <span class="input-group-text">h</span>
        </div>
      </div>
      <div class="col-md-2">
        <label class="form-label fw-bold small mb-1">深夜時間</label>
        <div class="input-group input-group-sm">
          <%= number_field_tag :late_night_hours, @comparison[:attendance][:late_night_hours], class: "form-control form-control-sm text-end", step: "any", min: 0, id: "late_night_hours" %>
          <span class="input-group-text">h</span>
        </div>
      </div>
      <div class="col-md-2">
        <label class="form-label fw-bold small mb-1">休日時間</label>
        <div class="input-group input-group-sm">
          <%= number_field_tag :holiday_hours, @comparison[:attendance][:holiday_hours], class: "form-control form-control-sm text-end", step: "any", min: 0, id: "holiday_hours" %>
          <span class="input-group-text">h</span>
        </div>
      </div>

      <!-- 過去1年平均 -->
      <% if @comparison[:yearly_average] %>
        <div class="col-12">
          <div class="alert alert-info py-2 mb-0 small">
            <strong>過去1年平均（<%= @comparison[:yearly_average][:months_count] %>ヶ月）:</strong>
            残業 <strong><%= @comparison[:yearly_average][:overtime_hours] %>h</strong> /
            深夜 <strong><%= @comparison[:yearly_average][:late_night_hours] %>h</strong> /
            休日 <strong><%= @comparison[:yearly_average][:holiday_hours] %>h</strong>
            <button type="button" class="btn btn-outline-primary btn-sm ms-3" onclick="applyYearlyAverage()">
              <i class="bi bi-arrow-down-circle me-1"></i>平均を適用
            </button>
          </div>
        </div>
        <script>
          function applyYearlyAverage() {
            document.getElementById('overtime_hours').value = '<%= @comparison[:yearly_average][:overtime_hours] %>';
            document.getElementById('late_night_hours').value = '<%= @comparison[:yearly_average][:late_night_hours] %>';
            document.getElementById('holiday_hours').value = '<%= @comparison[:yearly_average][:holiday_hours] %>';
          }
        </script>
      <% end %>

      <!-- 隠しパラメータ -->
      <%= hidden_field_tag :period_id, @period&.id %>
      <% @params.each do |key, value| %>
        <% next if [:selected_grade, :selected_safety, :selected_difficulty, :overtime_hours, :late_night_hours, :holiday_hours, :position_allowance, :role_allowance].include?(key) %>
        <%= hidden_field_tag key, value %>
      <% end %>

      <div class="col-12">
        <button type="submit" class="btn btn-primary btn-sm">
          <i class="bi bi-calculator me-1"></i> 再計算
        </button>
      </div>
    <% end %>
  </div>
</div>

<!-- 従業員情報 -->
<div class="alert alert-secondary py-2 mb-3">
  <strong><%= @employee.employee_code %></strong> <%= @employee.full_name %>
  <span class="badge bg-secondary ms-2"><%= @comparison[:location] %></span>
</div>

<!-- 比較表示 -->
<div class="row">
  <!-- 現行 -->
  <div class="col-md-5">
    <div class="card h-100">
      <div class="card-header py-2 bg-secondary text-white">
        <strong>現行給与</strong>
      </div>
      <div class="card-body p-0">
        <% cur = @comparison[:current] %>
        <%
          # 年収計算: 過去1年平均があればそれを使用、なければ現在の勤怠時間で計算
          if @comparison[:yearly_average]
            avg = @comparison[:yearly_average]
            avg_overtime_pay = (avg[:overtime_hours] * cur[:hourly_rate] * 1.25).round
            avg_late_night_pay = (avg[:late_night_hours] * cur[:hourly_rate] * 0.25).round
            avg_holiday_pay = (avg[:holiday_hours] * cur[:hourly_rate] * 1.35).round
            avg_variable_total = avg_overtime_pay + avg_late_night_pay + avg_holiday_pay
            cur_annual_gross = (cur[:fixed][:total] + avg_variable_total) * 12
            cur_annual_note = "過去#{avg[:months_count]}ヶ月平均"
          else
            cur_annual_gross = cur[:gross_total] * 12
            cur_annual_note = "現在の設定"
          end
        %>
        <!-- 年収イメージ -->
        <div class="bg-secondary bg-opacity-10 py-2 px-3 border-bottom">
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted small">年収イメージ（<%= cur_annual_note %>×12）</span>
            <span class="fs-5 fw-bold"><%= number_with_delimiter(cur_annual_gross) %> 円</span>
          </div>
        </div>
        <table class="table table-sm mb-0" style="font-size: 13px;">
          <!-- 支給 -->
          <thead class="table-light">
            <tr><th colspan="2">支給</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><%= cur[:fixed][:base_salary_label] %></td>
              <td class="text-end"><%= number_with_delimiter(cur[:fixed][:base_salary]) %></td>
            </tr>
            <% if cur[:fixed][:safety_bonus] > 0 %>
              <tr>
                <td><%= cur[:fixed][:safety_bonus_label] %></td>
                <td class="text-end"><%= number_with_delimiter(cur[:fixed][:safety_bonus]) %></td>
              </tr>
            <% end %>
            <% if cur[:fixed][:position] > 0 %>
              <tr>
                <td><%= cur[:fixed][:position_label] %></td>
                <td class="text-end"><%= number_with_delimiter(cur[:fixed][:position]) %></td>
              </tr>
            <% end %>
            <% if cur[:fixed][:role] > 0 %>
              <tr>
                <td><%= cur[:fixed][:role_label] %></td>
                <td class="text-end"><%= number_with_delimiter(cur[:fixed][:role]) %></td>
              </tr>
            <% end %>
            <% if cur[:fixed][:city] > 0 %>
              <tr>
                <td><%= cur[:fixed][:city_label] %></td>
                <td class="text-end"><%= number_with_delimiter(cur[:fixed][:city]) %></td>
              </tr>
            <% end %>
            <% if cur[:fixed][:adjustment].to_i > 0 %>
              <tr class="text-danger">
                <td><%= cur[:fixed][:adjustment_label] %></td>
                <td class="text-end"><%= number_with_delimiter(cur[:fixed][:adjustment]) %></td>
              </tr>
            <% end %>
            <% if cur[:fixed][:adjustment_allowance].to_i > 0 %>
              <tr class="text-danger">
                <td><%= cur[:fixed][:adjustment_allowance_label] %></td>
                <td class="text-end"><%= number_with_delimiter(cur[:fixed][:adjustment_allowance]) %></td>
              </tr>
            <% end %>
            <tr class="table-light">
              <td><strong>固定給計</strong></td>
              <td class="text-end"><strong><%= number_with_delimiter(cur[:fixed][:total]) %></strong></td>
            </tr>
            <tr>
              <td>時給 (<%= number_with_delimiter(cur[:fixed][:base_wage_total]) %> ÷ 163.8)</td>
              <td class="text-end"><%= number_with_delimiter(cur[:hourly_rate]) %> 円/h</td>
            </tr>
            <% if cur[:variable][:overtime_pay] > 0 %>
              <tr>
                <td>残業代 (<%= cur[:variable][:overtime_hours] %>h × <%= cur[:variable][:overtime_rate] %>)</td>
                <td class="text-end"><%= number_with_delimiter(cur[:variable][:overtime_pay]) %></td>
              </tr>
            <% end %>
            <% if cur[:variable][:late_night_pay] > 0 %>
              <tr>
                <td>深夜手当 (<%= cur[:variable][:late_night_hours] %>h × <%= cur[:variable][:late_night_rate] %>)</td>
                <td class="text-end"><%= number_with_delimiter(cur[:variable][:late_night_pay]) %></td>
              </tr>
            <% end %>
            <% if cur[:variable][:holiday_pay] > 0 %>
              <tr>
                <td>休日手当 (<%= cur[:variable][:holiday_hours] %>h × <%= cur[:variable][:holiday_rate] %>)</td>
                <td class="text-end"><%= number_with_delimiter(cur[:variable][:holiday_pay]) %></td>
              </tr>
            <% end %>
            <tr class="table-warning fw-bold">
              <td>総支給額</td>
              <td class="text-end"><%= number_with_delimiter(cur[:gross_total]) %></td>
            </tr>
          </tbody>

          <!-- 控除 -->
          <thead class="table-light">
            <tr><th colspan="2">控除（本人負担）</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>健康保険</td>
              <td class="text-end text-danger">-<%= number_with_delimiter(cur[:deductions][:health_insurance]) %></td>
            </tr>
            <% if cur[:deductions][:nursing_insurance] > 0 %>
              <tr>
                <td>介護保険</td>
                <td class="text-end text-danger">-<%= number_with_delimiter(cur[:deductions][:nursing_insurance]) %></td>
              </tr>
            <% end %>
            <tr>
              <td>厚生年金</td>
              <td class="text-end text-danger">-<%= number_with_delimiter(cur[:deductions][:pension_insurance]) %></td>
            </tr>
            <tr>
              <td>雇用保険</td>
              <td class="text-end text-danger">-<%= number_with_delimiter(cur[:deductions][:employment_insurance]) %></td>
            </tr>
            <tr>
              <td>所得税</td>
              <td class="text-end text-danger">-<%= number_with_delimiter(cur[:deductions][:income_tax]) %></td>
            </tr>
            <% if cur[:deductions][:resident_tax] > 0 %>
              <tr>
                <td>住民税</td>
                <td class="text-end text-danger">-<%= number_with_delimiter(cur[:deductions][:resident_tax]) %></td>
              </tr>
            <% end %>
            <tr class="table-light">
              <td><strong>控除計</strong></td>
              <td class="text-end text-danger"><strong>-<%= number_with_delimiter(cur[:deductions][:total]) %></strong></td>
            </tr>
            <tr class="table-success fw-bold fs-6">
              <td>手取り</td>
              <td class="text-end"><%= number_with_delimiter(cur[:net_total]) %></td>
            </tr>
          </tbody>

          <!-- 会社負担 -->
          <thead class="table-light">
            <tr><th colspan="2">会社負担</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>健康保険（会社）</td>
              <td class="text-end"><%= number_with_delimiter(cur[:employer_cost][:health_insurance]) %></td>
            </tr>
            <tr>
              <td>厚生年金（会社）</td>
              <td class="text-end"><%= number_with_delimiter(cur[:employer_cost][:pension_insurance]) %></td>
            </tr>
            <tr>
              <td>雇用保険（会社）</td>
              <td class="text-end"><%= number_with_delimiter(cur[:employer_cost][:employment_insurance]) %></td>
            </tr>
            <tr>
              <td>労災保険</td>
              <td class="text-end"><%= number_with_delimiter(cur[:employer_cost][:workers_comp_insurance]) %></td>
            </tr>
            <tr class="table-light">
              <td><strong>会社負担計</strong></td>
              <td class="text-end"><strong><%= number_with_delimiter(cur[:employer_cost][:total]) %></strong></td>
            </tr>
            <tr class="table-info fw-bold fs-6">
              <td>会社総人件費</td>
              <td class="text-end"><%= number_with_delimiter(cur[:company_cost]) %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- 差額表示 -->
  <div class="col-md-2 d-flex flex-column justify-content-center align-items-center">
    <i class="bi bi-arrow-right fs-1 text-muted mb-3"></i>

    <div class="text-center mb-3">
      <div class="small text-muted">手取り差額</div>
      <% net_diff = @comparison[:diff][:net] %>
      <div class="fs-4 fw-bold <%= net_diff >= 0 ? 'text-success' : 'text-danger' %>">
        <%= net_diff >= 0 ? '+' : '' %><%= number_with_delimiter(net_diff) %>
      </div>
    </div>

    <div class="text-center">
      <div class="small text-muted">会社人件費差額</div>
      <% cost_diff = @comparison[:diff][:company_cost] %>
      <div class="fs-5 <%= cost_diff >= 0 ? 'text-danger' : 'text-success' %>">
        <%= cost_diff >= 0 ? '+' : '' %><%= number_with_delimiter(cost_diff) %>
      </div>
    </div>
  </div>

  <!-- 新給与 -->
  <div class="col-md-5">
    <div class="card h-100 border-primary">
      <div class="card-header py-2 bg-primary text-white">
        <strong>新給与</strong>
      </div>
      <div class="card-body p-0">
        <% prop = @comparison[:proposed] %>
        <%
          # 年収計算: 過去1年平均があればそれを使用
          if @comparison[:yearly_average]
            avg = @comparison[:yearly_average]
            prop_avg_overtime_pay = (avg[:overtime_hours] * prop[:hourly_rate] * 1.25).round
            prop_avg_late_night_pay = (avg[:late_night_hours] * prop[:hourly_rate] * 0.25).round
            prop_avg_holiday_pay = (avg[:holiday_hours] * prop[:hourly_rate] * 1.35).round
            prop_avg_variable_total = prop_avg_overtime_pay + prop_avg_late_night_pay + prop_avg_holiday_pay
            prop_annual_gross = (prop[:fixed][:total] + prop_avg_variable_total) * 12
            prop_annual_note = "過去#{avg[:months_count]}ヶ月平均"
          else
            prop_annual_gross = prop[:gross_total] * 12
            prop_annual_note = "現在の設定"
          end
          annual_diff = prop_annual_gross - cur_annual_gross
        %>
        <!-- 年収イメージ -->
        <div class="bg-primary bg-opacity-10 py-2 px-3 border-bottom">
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted small">年収イメージ（<%= prop_annual_note %>×12）</span>
            <span class="fs-5 fw-bold">
              <%= number_with_delimiter(prop_annual_gross) %> 円
              <% if annual_diff != 0 %>
                <small class="<%= annual_diff > 0 ? 'text-success' : 'text-danger' %>">
                  (<%= annual_diff > 0 ? '+' : '' %><%= number_with_delimiter(annual_diff) %>)
                </small>
              <% end %>
            </span>
          </div>
        </div>
        <table class="table table-sm mb-0" style="font-size: 13px;">
          <!-- 支給 -->
          <thead class="table-light">
            <tr><th colspan="2">支給</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><%= prop[:fixed][:base_salary_label] %></td>
              <td class="text-end">
                <%= number_with_delimiter(prop[:fixed][:base_salary]) %>
                <% base_diff = prop[:fixed][:base_salary] - cur[:fixed][:base_salary] %>
                <% if base_diff != 0 %>
                  <small class="<%= base_diff > 0 ? 'text-success' : 'text-danger' %>">
                    (<%= base_diff > 0 ? '+' : '' %><%= number_with_delimiter(base_diff) %>)
                  </small>
                <% end %>
              </td>
            </tr>
            <% if prop[:fixed][:safety_bonus] > 0 || cur[:fixed][:safety_bonus] > 0 %>
              <tr>
                <td><%= prop[:fixed][:safety_bonus_label] || "無事故手当" %></td>
                <td class="text-end">
                  <%= number_with_delimiter(prop[:fixed][:safety_bonus]) %>
                  <% safety_diff = prop[:fixed][:safety_bonus] - cur[:fixed][:safety_bonus] %>
                  <% if safety_diff != 0 %>
                    <small class="<%= safety_diff > 0 ? 'text-success' : 'text-danger' %>">
                      (<%= safety_diff > 0 ? '+' : '' %><%= number_with_delimiter(safety_diff) %>)
                    </small>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <% if prop[:fixed][:position] > 0 %>
              <tr>
                <td><%= prop[:fixed][:position_label] %></td>
                <td class="text-end"><%= number_with_delimiter(prop[:fixed][:position]) %></td>
              </tr>
            <% end %>
            <% if prop[:fixed][:role] > 0 %>
              <tr>
                <td><%= prop[:fixed][:role_label] %></td>
                <td class="text-end"><%= number_with_delimiter(prop[:fixed][:role]) %></td>
              </tr>
            <% end %>
            <% if prop[:fixed][:area].to_i > 0 || cur[:fixed][:city].to_i > 0 %>
              <tr>
                <td><%= prop[:fixed][:area_label] || "エリア加算" %></td>
                <td class="text-end">
                  <%= number_with_delimiter(prop[:fixed][:area]) %>
                  <% area_diff = prop[:fixed][:area].to_i - cur[:fixed][:city].to_i %>
                  <% if area_diff != 0 %>
                    <small class="<%= area_diff > 0 ? 'text-success' : 'text-danger' %>">
                      (<%= area_diff > 0 ? '+' : '' %><%= number_with_delimiter(area_diff) %>)
                    </small>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <% if prop[:fixed][:difficulty].to_i > 0 %>
              <tr class="text-success">
                <td><%= prop[:fixed][:difficulty_label] %></td>
                <td class="text-end">
                  <%= number_with_delimiter(prop[:fixed][:difficulty]) %>
                  <small class="text-success">(+<%= number_with_delimiter(prop[:fixed][:difficulty]) %>)</small>
                </td>
              </tr>
            <% end %>
            <% if cur[:fixed][:adjustment].to_i > 0 || cur[:fixed][:adjustment_allowance].to_i > 0 %>
              <tr class="text-danger">
                <td><del>調整給・調整加算</del></td>
                <td class="text-end text-danger">
                  <del><%= number_with_delimiter(cur[:fixed][:adjustment].to_i + cur[:fixed][:adjustment_allowance].to_i) %></del>
                  <small>(廃止)</small>
                </td>
              </tr>
            <% end %>
            <tr class="table-light">
              <td><strong>固定給計</strong></td>
              <td class="text-end">
                <strong><%= number_with_delimiter(prop[:fixed][:total]) %></strong>
                <% fixed_diff = prop[:fixed][:total] - cur[:fixed][:total] %>
                <% if fixed_diff != 0 %>
                  <small class="<%= fixed_diff > 0 ? 'text-success' : 'text-danger' %>">
                    (<%= fixed_diff > 0 ? '+' : '' %><%= number_with_delimiter(fixed_diff) %>)
                  </small>
                <% end %>
              </td>
            </tr>
            <tr>
              <td>時給 (<%= number_with_delimiter(prop[:fixed][:base_wage_total]) %> ÷ 163.8)</td>
              <td class="text-end">
                <%= number_with_delimiter(prop[:hourly_rate]) %> 円/h
                <% hourly_diff = prop[:hourly_rate] - cur[:hourly_rate] %>
                <% if hourly_diff != 0 %>
                  <small class="<%= hourly_diff > 0 ? 'text-success' : 'text-danger' %>">
                    (<%= hourly_diff > 0 ? '+' : '' %><%= number_with_delimiter(hourly_diff) %>)
                  </small>
                <% end %>
              </td>
            </tr>
            <% if prop[:variable][:overtime_pay] > 0 || cur[:variable][:overtime_pay] > 0 %>
              <tr>
                <td>残業代 (<%= prop[:variable][:overtime_hours] %>h × <%= prop[:variable][:overtime_rate] %>)</td>
                <td class="text-end">
                  <%= number_with_delimiter(prop[:variable][:overtime_pay]) %>
                  <% ot_diff = prop[:variable][:overtime_pay] - cur[:variable][:overtime_pay] %>
                  <% if ot_diff != 0 %>
                    <small class="<%= ot_diff > 0 ? 'text-success' : 'text-danger' %>">
                      (<%= ot_diff > 0 ? '+' : '' %><%= number_with_delimiter(ot_diff) %>)
                    </small>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <% if prop[:variable][:late_night_pay] > 0 || cur[:variable][:late_night_pay] > 0 %>
              <tr>
                <td>深夜手当 (<%= prop[:variable][:late_night_hours] %>h × <%= prop[:variable][:late_night_rate] %>)</td>
                <td class="text-end">
                  <%= number_with_delimiter(prop[:variable][:late_night_pay]) %>
                  <% ln_diff = prop[:variable][:late_night_pay] - cur[:variable][:late_night_pay] %>
                  <% if ln_diff != 0 %>
                    <small class="<%= ln_diff > 0 ? 'text-success' : 'text-danger' %>">
                      (<%= ln_diff > 0 ? '+' : '' %><%= number_with_delimiter(ln_diff) %>)
                    </small>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <% if prop[:variable][:holiday_pay] > 0 || cur[:variable][:holiday_pay] > 0 %>
              <tr>
                <td>休日手当 (<%= prop[:variable][:holiday_hours] %>h × <%= prop[:variable][:holiday_rate] %>)</td>
                <td class="text-end">
                  <%= number_with_delimiter(prop[:variable][:holiday_pay]) %>
                  <% hd_diff = prop[:variable][:holiday_pay] - cur[:variable][:holiday_pay] %>
                  <% if hd_diff != 0 %>
                    <small class="<%= hd_diff > 0 ? 'text-success' : 'text-danger' %>">
                      (<%= hd_diff > 0 ? '+' : '' %><%= number_with_delimiter(hd_diff) %>)
                    </small>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <tr class="table-warning fw-bold">
              <td>総支給額</td>
              <td class="text-end">
                <%= number_with_delimiter(prop[:gross_total]) %>
                <% gross_diff = prop[:gross_total] - cur[:gross_total] %>
                <% if gross_diff != 0 %>
                  <small class="<%= gross_diff > 0 ? 'text-success' : 'text-danger' %>">
                    (<%= gross_diff > 0 ? '+' : '' %><%= number_with_delimiter(gross_diff) %>)
                  </small>
                <% end %>
              </td>
            </tr>
          </tbody>

          <!-- 控除 -->
          <thead class="table-light">
            <tr><th colspan="2">控除（本人負担）</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>健康保険</td>
              <td class="text-end text-danger">-<%= number_with_delimiter(prop[:deductions][:health_insurance]) %></td>
            </tr>
            <% if prop[:deductions][:nursing_insurance] > 0 %>
              <tr>
                <td>介護保険</td>
                <td class="text-end text-danger">-<%= number_with_delimiter(prop[:deductions][:nursing_insurance]) %></td>
              </tr>
            <% end %>
            <tr>
              <td>厚生年金</td>
              <td class="text-end text-danger">-<%= number_with_delimiter(prop[:deductions][:pension_insurance]) %></td>
            </tr>
            <tr>
              <td>雇用保険</td>
              <td class="text-end text-danger">-<%= number_with_delimiter(prop[:deductions][:employment_insurance]) %></td>
            </tr>
            <tr>
              <td>所得税</td>
              <td class="text-end text-danger">-<%= number_with_delimiter(prop[:deductions][:income_tax]) %></td>
            </tr>
            <% if prop[:deductions][:resident_tax] > 0 %>
              <tr>
                <td>住民税</td>
                <td class="text-end text-danger">-<%= number_with_delimiter(prop[:deductions][:resident_tax]) %></td>
              </tr>
            <% end %>
            <tr class="table-light">
              <td><strong>控除計</strong></td>
              <td class="text-end text-danger">
                <strong>-<%= number_with_delimiter(prop[:deductions][:total]) %></strong>
                <% ded_diff = prop[:deductions][:total] - cur[:deductions][:total] %>
                <% if ded_diff != 0 %>
                  <small class="<%= ded_diff < 0 ? 'text-success' : 'text-danger' %>">
                    (<%= ded_diff > 0 ? '+' : '' %><%= number_with_delimiter(ded_diff) %>)
                  </small>
                <% end %>
              </td>
            </tr>
            <tr class="table-success fw-bold fs-6">
              <td>手取り</td>
              <td class="text-end">
                <%= number_with_delimiter(prop[:net_total]) %>
                <% if net_diff != 0 %>
                  <small class="<%= net_diff > 0 ? 'text-success' : 'text-danger' %>">
                    (<%= net_diff > 0 ? '+' : '' %><%= number_with_delimiter(net_diff) %>)
                  </small>
                <% end %>
              </td>
            </tr>
          </tbody>

          <!-- 会社負担 -->
          <thead class="table-light">
            <tr><th colspan="2">会社負担</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>健康保険（会社）</td>
              <td class="text-end"><%= number_with_delimiter(prop[:employer_cost][:health_insurance]) %></td>
            </tr>
            <tr>
              <td>厚生年金（会社）</td>
              <td class="text-end"><%= number_with_delimiter(prop[:employer_cost][:pension_insurance]) %></td>
            </tr>
            <tr>
              <td>雇用保険（会社）</td>
              <td class="text-end"><%= number_with_delimiter(prop[:employer_cost][:employment_insurance]) %></td>
            </tr>
            <tr>
              <td>労災保険</td>
              <td class="text-end"><%= number_with_delimiter(prop[:employer_cost][:workers_comp_insurance]) %></td>
            </tr>
            <tr class="table-light">
              <td><strong>会社負担計</strong></td>
              <td class="text-end">
                <strong><%= number_with_delimiter(prop[:employer_cost][:total]) %></strong>
                <% emp_diff = prop[:employer_cost][:total] - cur[:employer_cost][:total] %>
                <% if emp_diff != 0 %>
                  <small class="<%= emp_diff < 0 ? 'text-success' : 'text-danger' %>">
                    (<%= emp_diff > 0 ? '+' : '' %><%= number_with_delimiter(emp_diff) %>)
                  </small>
                <% end %>
              </td>
            </tr>
            <tr class="table-info fw-bold fs-6">
              <td>会社総人件費</td>
              <td class="text-end">
                <%= number_with_delimiter(prop[:company_cost]) %>
                <% if cost_diff != 0 %>
                  <small class="<%= cost_diff < 0 ? 'text-success' : 'text-danger' %>">
                    (<%= cost_diff > 0 ? '+' : '' %><%= number_with_delimiter(cost_diff) %>)
                  </small>
                <% end %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- サマリー -->
<div class="card mt-3">
  <div class="card-body">
    <div class="row text-center">
      <div class="col-md-4">
        <div class="fs-6 text-muted">手取り変化</div>
        <div class="fs-3 fw-bold <%= net_diff >= 0 ? 'text-success' : 'text-danger' %>">
          <%= net_diff >= 0 ? '+' : '' %><%= number_with_delimiter(net_diff) %> 円
        </div>
        <div class="small text-muted">
          <%= number_with_delimiter(cur[:net_total]) %> → <%= number_with_delimiter(prop[:net_total]) %>
        </div>
      </div>
      <div class="col-md-4">
        <div class="fs-6 text-muted">会社人件費変化</div>
        <div class="fs-3 fw-bold <%= cost_diff <= 0 ? 'text-success' : 'text-danger' %>">
          <%= cost_diff >= 0 ? '+' : '' %><%= number_with_delimiter(cost_diff) %> 円
        </div>
        <div class="small text-muted">
          <%= number_with_delimiter(cur[:company_cost]) %> → <%= number_with_delimiter(prop[:company_cost]) %>
        </div>
      </div>
      <div class="col-md-4">
        <div class="fs-6 text-muted">判定</div>
        <% if net_diff >= 0 %>
          <div class="fs-3 fw-bold text-success"><i class="bi bi-check-circle"></i> OK</div>
          <div class="small text-muted">本人の手取りが維持/増加</div>
        <% else %>
          <div class="fs-3 fw-bold text-danger"><i class="bi bi-exclamation-triangle"></i> 要検討</div>
          <div class="small text-danger">本人の手取りが減少</div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- 仮決めボタン -->
<div class="card mt-3 border-warning">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h6 class="mb-1"><i class="bi bi-bookmark-star me-1"></i> この設定で仮決め</h6>
        <small class="text-muted">現在の設定を保存して、後で一覧で確認できます</small>
      </div>
      <div class="d-flex gap-2">
        <%= link_to draft_overview_admin_salary_scenarios_path(period_id: @period.id), class: "btn btn-outline-secondary" do %>
          <i class="bi bi-list-ul me-1"></i> 仮決め一覧
          <% draft_count = SalaryDraftDecision.for_period(@period).count %>
          <% if draft_count > 0 %>
            <span class="badge bg-secondary"><%= draft_count %></span>
          <% end %>
        <% end %>
        <%= form_tag save_draft_admin_salary_scenarios_path, method: :post, class: "d-inline" do %>
          <%= hidden_field_tag :employee_id, @employee.id %>
          <%= hidden_field_tag :period_id, @period.id %>
          <%= hidden_field_tag :location, @comparison[:location] %>
          <!-- 選択パラメータ -->
          <%= hidden_field_tag :selected_grade, @comparison[:proposed][:fixed][:selected_grade] %>
          <%= hidden_field_tag :selected_safety, @comparison[:proposed][:fixed][:selected_safety] %>
          <%= hidden_field_tag :selected_difficulty, @comparison[:proposed][:fixed][:selected_difficulty] %>
          <%= hidden_field_tag :position_allowance, @comparison[:proposed][:fixed][:position] %>
          <%= hidden_field_tag :role_allowance, @comparison[:proposed][:fixed][:role] %>
          <!-- 勤怠時間 -->
          <%= hidden_field_tag :overtime_hours, @comparison[:attendance][:overtime_hours] %>
          <%= hidden_field_tag :late_night_hours, @comparison[:attendance][:late_night_hours] %>
          <%= hidden_field_tag :holiday_hours, @comparison[:attendance][:holiday_hours] %>
          <!-- 現行 -->
          <%= hidden_field_tag :current_fixed_total, cur[:fixed][:total] %>
          <%= hidden_field_tag :current_gross_total, cur[:gross_total] %>
          <%= hidden_field_tag :current_net_total, cur[:net_total] %>
          <%= hidden_field_tag :current_company_cost, cur[:company_cost] %>
          <!-- 新給与 -->
          <%= hidden_field_tag :proposed_fixed_total, prop[:fixed][:total] %>
          <%= hidden_field_tag :proposed_gross_total, prop[:gross_total] %>
          <%= hidden_field_tag :proposed_net_total, prop[:net_total] %>
          <%= hidden_field_tag :proposed_company_cost, prop[:company_cost] %>
          <button type="submit" class="btn btn-warning">
            <i class="bi bi-bookmark-check me-1"></i> この設定で仮決め
          </button>
        <% end %>
      </div>
    </div>
    <%
      existing_draft = SalaryDraftDecision.find_by(employee: @employee, period: @period)
    %>
    <% if existing_draft %>
      <div class="alert alert-info mt-3 mb-0 py-2">
        <i class="bi bi-info-circle me-1"></i>
        この従業員は既に仮決め済みです（<%= existing_draft.grade_label %> / <%= existing_draft.safety_label %> / 難易度<%= existing_draft.difficulty_label %>）。
        再度保存すると上書きされます。
      </div>
    <% end %>
  </div>
</div>

<!-- 注意事項 -->
<div class="alert alert-warning mt-3 small">
  <i class="bi bi-exclamation-triangle me-1"></i>
  <strong>注意事項（会社負担について）:</strong>
  <ul class="mb-0 mt-1">
    <li>上記の「会社負担」には<strong>退職金の積立</strong>（中退共等）は含まれていません</li>
    <li><strong>賞与</strong>に対する社会保険料も別途発生します</li>
    <li>実際の人件費は、上記に加えて退職金積立・賞与の社会保険料等が加算されます</li>
  </ul>
</div>
