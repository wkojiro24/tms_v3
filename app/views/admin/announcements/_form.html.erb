<%= form_with model: [:admin, @announcement], class: "needs-validation" do |f| %>
  <% if @announcement.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @announcement.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-lg-8">
      <div class="card card-lift shadow-sm mb-3">
        <div class="card-header bg-transparent">
          <h6 class="card-title mb-0">基本情報</h6>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <%= f.label :title, "タイトル", class: "form-label" %>
            <%= f.text_field :title, class: "form-control", required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :body, "本文", class: "form-label" %>
            <%= f.text_area :body, class: "form-control", rows: 10 %>
            <div class="form-text">マークダウン形式には対応していません。改行はそのまま反映されます。</div>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <%= f.label :category, "カテゴリ", class: "form-label" %>
                <%= f.select :category, Announcement::CATEGORIES.map { |k, v| [v, k] }, {}, class: "form-select" %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <div class="form-check mt-4">
                  <%= f.check_box :pinned, class: "form-check-input" %>
                  <%= f.label :pinned, "固定表示（常に上部に表示）", class: "form-check-label" %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="card card-lift shadow-sm mb-3">
        <div class="card-header bg-transparent">
          <h6 class="card-title mb-0"><i class="bi bi-calendar-event me-2"></i>イベント情報（任意）</h6>
        </div>
        <div class="card-body">
          <p class="text-muted small">イベント日を設定すると、カレンダーに表示されます。</p>
          <div class="row">
            <div class="col-md-4">
              <div class="mb-3">
                <%= f.label :event_date, "イベント開始日", class: "form-label" %>
                <%= f.date_field :event_date, class: "form-control" %>
              </div>
            </div>
            <div class="col-md-4">
              <div class="mb-3">
                <%= f.label :event_end_date, "イベント終了日", class: "form-label" %>
                <%= f.date_field :event_end_date, class: "form-control" %>
                <div class="form-text">複数日にまたがる場合のみ</div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="mb-3">
                <%= f.label :event_location, "場所", class: "form-label" %>
                <%= f.text_field :event_location, class: "form-control", placeholder: "例: 本社会議室A" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card card-lift shadow-sm mb-3">
        <div class="card-header bg-transparent">
          <h6 class="card-title mb-0">公開設定</h6>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <%= f.label :published_at, "公開日時", class: "form-label" %>
            <%= f.datetime_local_field :published_at, class: "form-control" %>
            <div class="form-text">未設定の場合は下書きとして保存されます。</div>
          </div>

          <div class="mb-3">
            <%= f.label :expires_at, "公開終了日時", class: "form-label" %>
            <%= f.datetime_local_field :expires_at, class: "form-control" %>
            <div class="form-text">設定しない場合は無期限で公開されます。</div>
          </div>
        </div>
      </div>

      <div class="d-grid gap-2">
        <%= f.submit @announcement.new_record? ? "作成" : "更新", class: "btn btn-primary btn-lg" %>
        <%= link_to "キャンセル", admin_announcements_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
<% end %>
