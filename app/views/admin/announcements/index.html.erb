<% content_for :title, "お知らせ管理" %>
<% content_for :section_label, "管理者" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0">お知らせ管理</h4>
  <%= link_to new_admin_announcement_path, class: "btn btn-primary" do %>
    <i class="bi bi-plus-lg me-1"></i>新規作成
  <% end %>
</div>

<div class="card card-lift shadow-sm">
  <div class="card-body p-0">
    <% if @announcements.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>タイトル</th>
              <th>カテゴリ</th>
              <th>公開日</th>
              <th>イベント日</th>
              <th>状態</th>
              <th width="120">操作</th>
            </tr>
          </thead>
          <tbody>
            <% @announcements.each do |announcement| %>
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <% if announcement.pinned? %>
                      <i class="bi bi-pin-angle-fill text-danger"></i>
                    <% end %>
                    <%= link_to announcement.title, admin_announcement_path(announcement), class: "text-decoration-none" %>
                  </div>
                </td>
                <td>
                  <span class="badge bg-<%= category_badge_color(announcement.category) %>">
                    <%= announcement.category_label %>
                  </span>
                </td>
                <td><%= announcement.published_at&.strftime("%Y/%m/%d %H:%M") || "-" %></td>
                <td>
                  <% if announcement.event? %>
                    <i class="bi bi-calendar-event text-primary me-1"></i>
                    <%= announcement.event_period %>
                  <% else %>
                    -
                  <% end %>
                </td>
                <td>
                  <% if announcement.draft? %>
                    <span class="badge bg-secondary">下書き</span>
                  <% elsif announcement.expired? %>
                    <span class="badge bg-dark">期限切れ</span>
                  <% else %>
                    <span class="badge bg-success">公開中</span>
                  <% end %>
                </td>
                <td>
                  <div class="btn-group btn-group-sm">
                    <%= link_to edit_admin_announcement_path(announcement), class: "btn btn-outline-primary" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= button_to admin_announcement_path(announcement), method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "「#{announcement.title}」を削除しますか？" } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center text-muted py-5">
        <i class="bi bi-megaphone fs-1 d-block mb-3"></i>
        お知らせがありません
        <div class="mt-3">
          <%= link_to "新規作成", new_admin_announcement_path, class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
