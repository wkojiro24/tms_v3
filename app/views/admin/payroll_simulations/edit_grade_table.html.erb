<% content_for :title, "等級編集" %>
<% content_for :section_label, "人事管理" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="h4 mb-0">等級「<%= @grade_table.grade_code %>」を編集</h2>
  <%= link_to "戻る", grade_tables_admin_payroll_simulations_path, class: "btn btn-outline-secondary btn-sm" %>
</div>

<%= form_with model: @grade_table, url: update_grade_table_admin_payroll_simulations_path(@grade_table), method: :patch, class: "needs-validation" do |f| %>
  <div class="card card-lift">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <%= f.label :grade_code, "等級コード", class: "form-label" %>
          <%= f.text_field :grade_code, class: "form-control", required: true %>
        </div>
        <div class="col-md-4">
          <%= f.label :grade_name, "等級名", class: "form-label" %>
          <%= f.text_field :grade_name, class: "form-control" %>
        </div>
        <div class="col-md-4">
          <%= f.label :grade_level_id, "評価等級（マスタ）", class: "form-label" %>
          <%= f.collection_select :grade_level_id, @grade_levels, :id, :name, { include_blank: "（未選択）" }, class: "form-select" %>
        </div>
      </div>

      <hr class="my-4">

      <div class="row g-3">
        <div class="col-md-4">
          <%= f.label :base_salary, "基本給（月額）", class: "form-label" %>
          <div class="input-group">
            <%= f.number_field :base_salary, class: "form-control", required: true, min: 0 %>
            <span class="input-group-text">円</span>
          </div>
        </div>
        <div class="col-md-4">
          <%= f.label :city_allowance, "大都市加算", class: "form-label" %>
          <div class="input-group">
            <%= f.number_field :city_allowance, class: "form-control", min: 0 %>
            <span class="input-group-text">円</span>
          </div>
        </div>
        <div class="col-md-4">
          <%= f.label :hourly_rate, "時給（空欄で自動計算）", class: "form-label" %>
          <div class="input-group">
            <%= f.number_field :hourly_rate, class: "form-control", min: 0 %>
            <span class="input-group-text">円</span>
          </div>
        </div>
      </div>

      <hr class="my-4">
      <h6 class="text-muted mb-3">割増率</h6>

      <div class="row g-3">
        <div class="col-md-4">
          <%= f.label :overtime_rate, "残業割増率", class: "form-label" %>
          <div class="input-group">
            <%= f.number_field :overtime_rate, class: "form-control", step: 0.01, min: 1 %>
            <span class="input-group-text">倍</span>
          </div>
        </div>
        <div class="col-md-4">
          <%= f.label :late_night_rate, "深夜追加率", class: "form-label" %>
          <div class="input-group">
            <%= f.number_field :late_night_rate, class: "form-control", step: 0.01, min: 0 %>
            <span class="input-group-text">倍</span>
          </div>
        </div>
        <div class="col-md-4">
          <%= f.label :holiday_rate, "休日割増率", class: "form-label" %>
          <div class="input-group">
            <%= f.number_field :holiday_rate, class: "form-control", step: 0.01, min: 1 %>
            <span class="input-group-text">倍</span>
          </div>
        </div>
      </div>

      <hr class="my-4">
      <h6 class="text-muted mb-3">有効期間</h6>

      <div class="row g-3">
        <div class="col-md-4">
          <%= f.label :effective_from, "有効開始日", class: "form-label" %>
          <%= f.date_field :effective_from, class: "form-control" %>
        </div>
        <div class="col-md-4">
          <%= f.label :effective_until, "有効終了日", class: "form-label" %>
          <%= f.date_field :effective_until, class: "form-control" %>
        </div>
        <div class="col-md-4">
          <%= f.label :active, "ステータス", class: "form-label" %>
          <div class="form-check form-switch mt-2">
            <%= f.check_box :active, class: "form-check-input" %>
            <%= f.label :active, "有効", class: "form-check-label" %>
          </div>
        </div>
      </div>

      <div class="row g-3 mt-2">
        <div class="col-12">
          <%= f.label :notes, "備考", class: "form-label" %>
          <%= f.text_area :notes, class: "form-control", rows: 2 %>
        </div>
      </div>
    </div>
    <div class="card-footer bg-transparent">
      <%= f.submit "更新", class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
