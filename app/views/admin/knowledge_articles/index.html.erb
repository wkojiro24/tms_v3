<% content_for :title, "記事一覧" %>
<% content_for :section_label, "ナレッジ管理" %>
<% content_for :header_actions do %>
  <%= link_to new_admin_knowledge_article_path, class: "btn btn-primary btn-sm" do %>
    <i class="bi bi-plus-lg me-1"></i>新規作成
  <% end %>
<% end %>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <% if @articles.any? %>
      <% KnowledgeArticle::CATEGORIES.each do |key, label| %>
        <% articles_in_category = @articles_by_category[key] || [] %>
        <% if articles_in_category.any? %>
          <div class="border-bottom">
            <div class="px-3 py-2 bg-light d-flex justify-content-between align-items-center">
              <strong><%= label %></strong>
              <span class="badge bg-secondary"><%= articles_in_category.size %></span>
            </div>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <tbody>
                  <% articles_in_category.each do |article| %>
                    <tr>
                      <td>
                        <div class="fw-medium"><%= article.title %></div>
                        <small class="text-muted">
                          <i class="bi bi-eye me-1"></i><%= article.view_count %>
                          <span class="mx-1">|</span>
                          更新: <%= article.updated_at.strftime("%Y/%m/%d") %>
                        </small>
                      </td>
                      <td width="100">
                        <% if article.published? %>
                          <span class="badge bg-success">公開中</span>
                        <% else %>
                          <span class="badge bg-secondary">下書き</span>
                        <% end %>
                      </td>
                      <td width="180">
                        <div class="btn-group btn-group-sm">
                          <% if article.published? %>
                            <%= link_to knowledge_article_path(article), class: "btn btn-outline-secondary", target: "_blank", title: "プレビュー" do %>
                              <i class="bi bi-eye"></i>
                            <% end %>
                            <%= button_to unpublish_admin_knowledge_article_path(article), method: :post, class: "btn btn-outline-warning", title: "非公開にする" do %>
                              <i class="bi bi-eye-slash"></i>
                            <% end %>
                          <% else %>
                            <%= button_to publish_admin_knowledge_article_path(article), method: :post, class: "btn btn-outline-success", title: "公開する" do %>
                              <i class="bi bi-check-lg"></i>
                            <% end %>
                          <% end %>
                          <%= link_to edit_admin_knowledge_article_path(article), class: "btn btn-outline-primary", title: "編集" do %>
                            <i class="bi bi-pencil"></i>
                          <% end %>
                          <%= button_to admin_knowledge_article_path(article), method: :delete, class: "btn btn-outline-danger", data: { turbo_confirm: "「#{article.title}」を削除しますか？" }, title: "削除" do %>
                            <i class="bi bi-trash"></i>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <div class="text-center text-muted py-5">
        <i class="bi bi-book fs-1 d-block mb-3"></i>
        記事がありません
        <div class="mt-3">
          <%= link_to "新規作成", new_admin_knowledge_article_path, class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
