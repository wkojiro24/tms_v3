<% content_for :title, "ダッシュボード" %>
<% content_for :section_label, "運行状況サマリー" %>

<!-- 統計カード -->
<div class="row g-4">
  <div class="col-xl-3 col-md-6">
    <div class="card card-lift shadow-sm h-100">
      <div class="card-body">
        <span class="badge-soft mb-3"><i class="bi bi-graph-up-arrow"></i> 当月売上</span>
        <div class="stat-value text-primary"><%= number_to_currency(@revenue_metrics[:revenue], unit: "¥", precision: 0) %></div>
        <% if @last_month_metrics[:revenue] > 0 %>
          <% change = ((@revenue_metrics[:revenue] - @last_month_metrics[:revenue]) / @last_month_metrics[:revenue].to_f * 100).round(1) %>
          <div class="text-muted small">
            前月比
            <span class="<%= change >= 0 ? 'text-success' : 'text-danger' %> fw-semibold">
              <%= change >= 0 ? '+' : '' %><%= change %>%
            </span>
          </div>
        <% else %>
          <div class="text-muted small">前月データなし</div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="card card-lift shadow-sm h-100">
      <div class="card-body">
        <span class="badge-soft mb-3"><i class="bi bi-speedometer2"></i> 稼働率</span>
        <div class="stat-value text-info"><%= @vehicle_stats[:utilization_rate] %>%</div>
        <div class="text-muted small">
          車両<%= @vehicle_stats[:total] %>台中 <%= @vehicle_stats[:active] %>台稼働中
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="card card-lift shadow-sm h-100">
      <div class="card-body">
        <span class="badge-soft mb-3"><i class="bi bi-people"></i> 従業員</span>
        <div class="stat-value text-warning"><%= @employee_stats[:total] %> 名</div>
        <div class="text-muted small">
          在籍 <%= @employee_stats[:active] %>名
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="card card-lift shadow-sm h-100">
      <div class="card-body">
        <span class="badge-soft mb-3"><i class="bi bi-cash-stack"></i> 当月利益</span>
        <% profit_color = @revenue_metrics[:profit] >= 0 ? 'text-success' : 'text-danger' %>
        <div class="stat-value <%= profit_color %>"><%= number_to_currency(@revenue_metrics[:profit], unit: "¥", precision: 0) %></div>
        <div class="text-muted small">
          収支データ <%= @revenue_metrics[:vehicle_count] %>台分
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mt-1">
  <!-- 車両アラート -->
  <div class="col-xxl-7">
    <div class="card card-lift shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h2 class="h5 mb-0"><i class="bi bi-exclamation-triangle text-warning me-2"></i>車両アラート</h2>
          <%= link_to maintenance_schedule_path, class: "btn btn-sm btn-outline-primary" do %>
            整備計画へ
          <% end %>
        </div>

        <% if @vehicles_needing_attention.any? || @upcoming_inspections.any? %>
          <div class="list-group list-group-flush">
            <% @vehicles_needing_attention.each do |vehicle| %>
              <div class="list-group-item border-0 px-0 d-flex align-items-start gap-3">
                <span class="badge rounded-pill text-bg-danger mt-1">要対応</span>
                <div>
                  <div class="fw-semibold"><%= vehicle.call_sign || vehicle.registration_number %></div>
                  <div class="text-muted small">
                    ステータス: <%= vehicle.fault_status %>
                    <% if vehicle.depot_name.present? %>
                      / <%= vehicle.depot_name %>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>

            <% @upcoming_inspections.each do |vehicle| %>
              <div class="list-group-item border-0 px-0 d-flex align-items-start gap-3">
                <span class="badge rounded-pill text-bg-warning mt-1">車検</span>
                <div>
                  <div class="fw-semibold"><%= vehicle.call_sign || vehicle.registration_number %></div>
                  <div class="text-muted small">
                    車検期限が近づいています
                    <% if vehicle.depot_name.present? %>
                      / <%= vehicle.depot_name %>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center text-muted py-4">
            <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
            現在アラートはありません
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- 未処理ワークフロー -->
  <div class="col-xxl-5">
    <div class="card card-lift shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h2 class="h5 mb-0"><i class="bi bi-inbox text-primary me-2"></i>未処理タスク</h2>
          <%= link_to workflow_requests_path, class: "btn btn-sm btn-outline-secondary" do %>
            ワークフロー
          <% end %>
        </div>

        <% if @pending_workflows.any? %>
          <div class="list-group list-group-flush">
            <% @pending_workflows.each do |workflow| %>
              <%= link_to workflow_request_path(workflow), class: "list-group-item list-group-item-action border-0 px-0" do %>
                <div class="d-flex align-items-center justify-content-between">
                  <div>
                    <div class="fw-semibold"><%= workflow.title %></div>
                    <div class="text-muted small">
                      <%= workflow.workflow_category&.name %> ・ <%= l(workflow.created_at, format: :short) rescue workflow.created_at.strftime("%m/%d %H:%M") %>
                    </div>
                  </div>
                  <span class="badge rounded-pill text-bg-<%= workflow_status_color(workflow.status) %>">
                    <%= workflow_status_label(workflow.status) %>
                  </span>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="text-center text-muted py-4">
            <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
            未処理タスクはありません
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mt-1">
  <!-- お知らせ -->
  <div class="col-lg-6">
    <div class="card card-lift shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h2 class="h5 mb-0"><i class="bi bi-megaphone text-info me-2"></i>お知らせ</h2>
          <%= link_to announcements_path, class: "btn btn-sm btn-outline-secondary" do %>
            一覧へ
          <% end %>
        </div>

        <% if @announcements.any? %>
          <div class="list-group list-group-flush">
            <% @announcements.each do |announcement| %>
              <%= link_to announcement_path(announcement), class: "list-group-item list-group-item-action border-0 px-0" do %>
                <div class="d-flex align-items-start gap-2">
                  <% if announcement.pinned? %>
                    <i class="bi bi-pin-angle-fill text-danger mt-1"></i>
                  <% end %>
                  <div>
                    <div class="fw-semibold"><%= announcement.title %></div>
                    <div class="text-muted small">
                      <span class="badge bg-secondary-subtle text-dark me-1"><%= announcement.category_label %></span>
                      <%= announcement.published_at&.strftime("%Y/%m/%d") %>
                      <% if announcement.author.present? %>
                        ・ <%= announcement.author.email.split('@').first %>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="text-center text-muted py-4">
            <i class="bi bi-megaphone fs-1 d-block mb-2 text-secondary"></i>
            お知らせはありません
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- 車両情報 -->
  <div class="col-lg-6">
    <div class="card card-lift shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h2 class="h5 mb-0"><i class="bi bi-truck text-secondary me-2"></i>車両情報</h2>
          <%= link_to vehicles_path, class: "btn btn-sm btn-outline-secondary" do %>
            一覧へ
          <% end %>
        </div>
        <div class="row text-center">
          <div class="col-4">
            <div class="fs-3 fw-bold text-primary"><%= @vehicle_stats[:total] %></div>
            <div class="text-muted small">総車両数</div>
          </div>
          <div class="col-4">
            <div class="fs-3 fw-bold text-success"><%= @vehicle_stats[:active] %></div>
            <div class="text-muted small">稼働中</div>
          </div>
          <div class="col-4">
            <div class="fs-3 fw-bold text-warning"><%= @vehicles_needing_attention.count %></div>
            <div class="text-muted small">要対応</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4 mt-1">
  <!-- クイックリンク -->
  <div class="col-12">
    <div class="card card-lift shadow-sm">
      <div class="card-body">
        <h2 class="h5 mb-3"><i class="bi bi-lightning text-warning me-2"></i>クイックアクセス</h2>
        <div class="d-flex flex-wrap gap-2">
          <%= link_to vehicle_financials_path, class: "btn btn-outline-primary" do %>
            <i class="bi bi-table me-1"></i>収支グリッド
          <% end %>
          <%= link_to journal_entries_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-journal-text me-1"></i>仕訳明細
          <% end %>
          <%= link_to hr_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-person-badge me-1"></i>社員情報
          <% end %>
          <% if current_user&.admin_role? %>
            <%= link_to new_admin_import_path, class: "btn btn-outline-success" do %>
              <i class="bi bi-upload me-1"></i>データインポート
            <% end %>
            <%= link_to admin_payroll_simulations_path, class: "btn btn-outline-info" do %>
              <i class="bi bi-calculator me-1"></i>給与シミュレーション
            <% end %>
            <%= link_to admin_announcements_path, class: "btn btn-outline-warning" do %>
              <i class="bi bi-megaphone me-1"></i>お知らせ管理
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
