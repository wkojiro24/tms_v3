<div class="p-2">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <span class="text-muted small">期間: <%= @period_start.strftime("%Y/%m/%d") %> 〜 <%= @period_end.strftime("%Y/%m/%d") %></span>
    </div>
    <div class="text-end">
      <span class="badge bg-primary me-2">借方計: <%= number_with_delimiter(@totals[:debit]) %></span>
      <span class="badge bg-success">貸方計: <%= number_with_delimiter(@totals[:credit]) %></span>
    </div>
  </div>

  <% if @journal_lines.any? %>
    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
      <table class="table table-sm table-hover small mb-0">
        <thead class="sticky-top bg-white">
          <tr>
            <th style="width: 70px;">日付</th>
            <th>補助科目</th>
            <th>相手科目</th>
            <th class="text-end" style="width: 100px;">借方</th>
            <th class="text-end" style="width: 100px;">貸方</th>
          </tr>
        </thead>
        <tbody>
          <% @journal_lines.each do |line| %>
            <% vendor_name = line.sub_account_name.presence || @vendor_names[line.id] %>
            <tr>
              <td class="text-muted"><%= line.journal_entry.entry_date.strftime("%m/%d") %></td>
              <td class="text-truncate" style="max-width: 150px;" title="<%= vendor_name %>">
                <%= vendor_name.presence || "-" %>
              </td>
              <td>
                <% counter_line = line.journal_entry.journal_lines.find { |l| l.id != line.id } %>
                <%= counter_line&.account_name || "-" %>
              </td>
              <td class="text-end">
                <% if line.side == "debit" %>
                  <%= number_with_delimiter(line.amount) %>
                <% end %>
              </td>
              <td class="text-end">
                <% if line.side == "credit" %>
                  <%= number_with_delimiter(line.amount) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @journal_lines.size >= 100 %>
      <p class="text-muted small mt-2 mb-0">※ 最大100件まで表示しています</p>
    <% end %>
  <% else %>
    <div class="alert alert-info mb-0">
      この期間に該当する仕訳データはありません
    </div>
  <% end %>
</div>
