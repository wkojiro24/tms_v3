<% content_for :title, "部門別コスト分析" %>
<% content_for :section_label, "経営" %>
<% content_for :subtitle, @fiscal_year_label %>

<div class="d-flex justify-content-end mb-4">
  <div class="d-flex gap-2 align-items-center">
    <form action="<%= department_analysis_profit_loss_index_path %>" method="get" class="d-flex gap-2 flex-wrap">
      <!-- 表示モード切替 -->
      <div class="btn-group btn-group-sm" role="group">
        <input type="radio" class="btn-check" name="view_mode" id="viewYearly" value="yearly" <%= 'checked' if @view_mode == 'yearly' %> onchange="this.form.submit()">
        <label class="btn btn-outline-primary" for="viewYearly">年次</label>
        <input type="radio" class="btn-check" name="view_mode" id="viewMonthly" value="monthly" <%= 'checked' if @view_mode == 'monthly' %> onchange="this.form.submit()">
        <label class="btn btn-outline-primary" for="viewMonthly">月次</label>
      </div>

      <% if @view_mode == 'monthly' %>
        <!-- 月次モード：年月選択 -->
        <select name="year" class="form-select form-select-sm" style="width: auto;">
          <% (Date.current.year - 2..Date.current.year).each do |y| %>
            <option value="<%= y %>" <%= 'selected' if y == @selected_year %>><%= y %>年</option>
          <% end %>
        </select>
        <select name="month" class="form-select form-select-sm" style="width: auto;">
          <% (1..12).each do |m| %>
            <option value="<%= m %>" <%= 'selected' if m == @selected_month %>><%= m %>月</option>
          <% end %>
        </select>
      <% else %>
        <!-- 年次モード：期選択 -->
        <select name="fiscal_year" class="form-select form-select-sm" style="width: auto;">
          <% (Date.current.year - 5..Date.current.year).each do |y| %>
            <option value="<%= y %>" <%= 'selected' if y == @fiscal_year %>>第<%= fiscal_period_number_for(y) %>期</option>
          <% end %>
        </select>
      <% end %>

      <select name="expense" class="form-select form-select-sm" style="width: auto;">
        <% @expense_categories.each do |cat| %>
          <option value="<%= cat[:key] %>" <%= 'selected' if cat[:key] == @selected_expense %>><%= cat[:name] %></option>
        <% end %>
      </select>
      <button type="submit" class="btn btn-primary btn-sm">表示</button>
    </form>
    <%= link_to "P/Lダッシュボード", dashboard_profit_loss_index_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<%
  expense_name = @expense_categories.find { |e| e[:key] == @selected_expense }&.dig(:name) || "費用"

  # 部門カラー設定
  dept_colors = {
    "小名浜営業所" => "#3b82f6",
    "仙台営業所" => "#ef4444",
    "東京営業所" => "#f59e0b",
    "川崎営業所" => "#10b981",
    "九州営業所" => "#8b5cf6",
    "本社" => "#6366f1",
    "不動産部門" => "#ec4899",
    "安全企画室" => "#14b8a6"
  }

  # 月ラベル生成（年次モードの場合のみ）
  months = []
  dept_series = []
  if @view_mode == 'yearly' && @monthly_data.present?
    current = @fiscal_year_start
    while current <= @period_end
      months << current.strftime("%Y-%m")
      current = current.next_month
    end

    # 部門別の月次データ配列を作成
    dept_series = @departments.map do |dept|
      {
        name: dept,
        color: dept_colors[dept] || "#999999",
        data: months.map { |m| (@monthly_data[m] && @monthly_data[m][dept]) || 0 }
      }
    end
  end

  # 期間ラベル
  period_label_for_card = @view_mode == 'monthly' ? @period_label : "年度"
%>

<div class="row g-4">
  <!-- 部門別累計カード -->
  <div class="col-12">
    <div class="card card-lift shadow-sm">
      <div class="card-body">
        <h3 class="h6 text-muted text-uppercase mb-3"><%= expense_name %> 部門別累計（<%= period_label_for_card %>）</h3>
        <div class="row g-3">
          <% @department_totals.sort_by { |_, v| -v }.each do |dept, amount| %>
            <%
              prev_amount = @prev_department_totals[dept] || 0
              change_rate = prev_amount > 0 ? ((amount.to_f / prev_amount * 100) - 100).round(1) : 0
              anomaly = @anomalies.find { |a| a[:department] == dept }
            %>
            <div class="col-md-4 col-lg-3">
              <div class="card h-100 <%= anomaly&.dig(:status) == 'high' ? 'border-danger' : '' %>">
                <div class="card-body py-2">
                  <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small"><%= dept %></span>
                    <% if anomaly %>
                      <span class="badge bg-<%= anomaly[:status] == 'high' ? 'danger' : 'info' %>">
                        <%= anomaly[:status] == 'high' ? '高' : '低' %>
                      </span>
                    <% end %>
                  </div>
                  <div class="h5 mb-0"><%= number_with_delimiter(amount / 10000) %><small class="text-muted">万円</small></div>
                  <% if prev_amount > 0 %>
                    <small class="<%= change_rate >= 0 ? 'text-danger' : 'text-success' %>">
                      <%= @view_mode == 'monthly' ? '前月比' : '前年比' %> <%= change_rate >= 0 ? '+' : '' %><%= change_rate %>%
                    </small>
                  <% else %>
                    <small class="text-muted"><%= @view_mode == 'monthly' ? '前月' : '前年' %>データなし</small>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @view_mode == 'yearly' %>
    <!-- 月次推移グラフ（年次モードのみ） -->
    <div class="col-lg-8">
      <div class="card card-lift shadow-sm">
        <div class="card-body">
          <h3 class="h6 text-muted text-uppercase mb-3"><%= expense_name %> 月次推移（部門別）</h3>
          <div style="height: 350px;">
            <canvas id="monthlyTrendChart"></canvas>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- 部門別構成比 -->
  <div class="<%= @view_mode == 'yearly' ? 'col-lg-4' : 'col-lg-6' %>">
    <div class="card card-lift shadow-sm">
      <div class="card-body">
        <h3 class="h6 text-muted text-uppercase mb-3"><%= expense_name %> 部門別構成比</h3>
        <div style="height: 350px;">
          <canvas id="deptPieChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- 部門間比較（棒グラフ） -->
  <div class="col-lg-6">
    <div class="card card-lift shadow-sm">
      <div class="card-body">
        <h3 class="h6 text-muted text-uppercase mb-3"><%= expense_name %> 部門間比較（<%= @view_mode == 'monthly' ? '当月 vs 前月' : '当期 vs 前期' %>）</h3>
        <div style="height: 300px;">
          <canvas id="deptComparisonChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- 異常値アラート -->
  <div class="col-lg-6">
    <div class="card card-lift shadow-sm">
      <div class="card-body">
        <h3 class="h6 text-muted text-uppercase mb-3">異常値検出</h3>
        <% if @anomalies.any? %>
          <div class="table-responsive">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>部門</th>
                  <th class="text-end">金額</th>
                  <th class="text-end">平均との乖離</th>
                  <th>ステータス</th>
                </tr>
              </thead>
              <tbody>
                <% @anomalies.each do |anomaly| %>
                  <tr>
                    <td><%= anomaly[:department] %></td>
                    <td class="text-end"><%= number_with_delimiter(anomaly[:amount] / 10000) %>万円</td>
                    <td class="text-end"><%= anomaly[:deviation] > 0 ? '+' : '' %><%= anomaly[:deviation] %>σ</td>
                    <td>
                      <span class="badge bg-<%= anomaly[:status] == 'high' ? 'danger' : 'info' %>">
                        <%= anomaly[:status] == 'high' ? '平均より高い' : '平均より低い' %>
                      </span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <p class="text-muted small mb-0">
            ※ 平均から1.5σ以上乖離している部門を検出しています
          </p>
        <% else %>
          <div class="text-center text-muted py-4">
            <i class="bi bi-check-circle fs-1"></i>
            <p class="mt-2 mb-0">異常な乖離は検出されませんでした</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <% if @vendor_totals.any? %>
    <!-- 取引先（補助科目）別分析 -->
    <div class="col-12">
      <div class="card card-lift shadow-sm">
        <div class="card-body">
          <h3 class="h6 text-muted text-uppercase mb-3"><%= expense_name %> 取引先（補助科目）別内訳</h3>
          <div class="row">
            <!-- 取引先別構成比 -->
            <div class="col-lg-5">
              <div style="height: 300px;">
                <canvas id="vendorPieChart"></canvas>
              </div>
            </div>
            <!-- 取引先別テーブル -->
            <div class="col-lg-7">
              <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                <table class="table table-sm table-hover">
                  <thead class="sticky-top bg-white">
                    <tr>
                      <th>取引先/補助科目</th>
                      <th class="text-end">金額</th>
                      <th class="text-end">構成比</th>
                    </tr>
                  </thead>
                  <tbody>
                    <%
                      total_vendor = @vendor_totals.values.sum
                    %>
                    <% @vendor_totals.first(15).each do |vendor, amount| %>
                      <tr>
                        <td><%= vendor %></td>
                        <td class="text-end"><%= number_with_delimiter(amount / 10000) %>万円</td>
                        <td class="text-end"><%= total_vendor > 0 ? ((amount.to_f / total_vendor) * 100).round(1) : 0 %>%</td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 部門×取引先マトリクス -->
    <% if @vendor_by_department.any? %>
      <div class="col-12">
        <div class="card card-lift shadow-sm">
          <div class="card-body">
            <h3 class="h6 text-muted text-uppercase mb-3"><%= expense_name %> 部門×取引先マトリクス</h3>
            <div class="table-responsive">
              <%
                all_vendors = @vendor_by_department.values.flat_map(&:keys).uniq.sort_by { |v| -(@vendor_totals[v] || 0) }.first(8)
                dept_list = @vendor_by_department.keys.sort
              %>
              <table class="table table-sm table-bordered">
                <thead>
                  <tr>
                    <th class="bg-light">部門</th>
                    <% all_vendors.each do |vendor| %>
                      <th class="text-end bg-light text-truncate" style="max-width: 100px;" title="<%= vendor %>"><%= vendor %></th>
                    <% end %>
                    <th class="text-end bg-light">合計</th>
                  </tr>
                </thead>
                <tbody>
                  <% dept_list.each do |dept| %>
                    <tr>
                      <td class="fw-medium"><%= dept %></td>
                      <% all_vendors.each do |vendor| %>
                        <%
                          val = @vendor_by_department[dept]&.dig(vendor) || 0
                          # ヒートマップ色（高いほど濃い青）
                          max_val = @vendor_by_department.values.flat_map { |h| h.values }.max || 1
                          intensity = val > 0 ? ((val.to_f / max_val) * 0.6 + 0.1) : 0
                        %>
                        <td class="text-end" style="<%= val > 0 ? "background-color: rgba(59, 130, 246, #{intensity});" : '' %>">
                          <%= val > 0 ? number_with_delimiter(val / 10000) : '-' %>
                        </td>
                      <% end %>
                      <td class="text-end fw-bold">
                        <%= number_with_delimiter((@vendor_by_department[dept]&.values&.sum || 0) / 10000) %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
                <tfoot>
                  <tr class="table-secondary">
                    <td class="fw-bold">合計</td>
                    <% all_vendors.each do |vendor| %>
                      <td class="text-end fw-bold">
                        <%= number_with_delimiter((@vendor_totals[vendor] || 0) / 10000) %>
                      </td>
                    <% end %>
                    <td class="text-end fw-bold">
                      <%= number_with_delimiter(@vendor_totals.values.sum / 10000) %>
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
            <p class="text-muted small mb-0">※ 単位：万円　背景色は金額の大きさを示しています</p>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <!-- 取引先データなしの場合 -->
    <div class="col-12">
      <div class="card card-lift shadow-sm">
        <div class="card-body text-center py-4">
          <i class="bi bi-info-circle text-muted fs-1"></i>
          <p class="text-muted mt-2 mb-0">
            この費目には取引先（補助科目）データがありません。<br>
            <small>仕訳データに補助科目が登録されていると、取引先別の内訳が表示されます。</small>
          </p>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%
  # グラフ用データ準備
  month_labels = months.map { |m| Date.parse("#{m}-01").strftime("%-m月") }

  dept_totals_sorted = @department_totals.sort_by { |_, v| -v }
  pie_labels = dept_totals_sorted.map { |d, _| d }
  pie_data = dept_totals_sorted.map { |_, v| (v / 10000).to_i }
  pie_colors = pie_labels.map { |d| dept_colors[d] || "#999999" }

  comparison_labels = @departments.sort
  current_data = comparison_labels.map { |d| ((@department_totals[d] || 0) / 10000).to_i }
  prev_data = comparison_labels.map { |d| ((@prev_department_totals[d] || 0) / 10000).to_i }

  # 取引先別データ
  vendor_chart_colors = ['#3b82f6', '#ef4444', '#f59e0b', '#10b981', '#8b5cf6', '#ec4899', '#6366f1', '#14b8a6', '#f97316', '#06b6d4']
  vendor_labels = @vendor_totals.first(10).map { |v, _| v }
  vendor_data = @vendor_totals.first(10).map { |_, a| (a / 10000).to_i }
%>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function() {
  if (typeof Chart === 'undefined') {
    console.error('Chart.js not loaded');
    return;
  }

  Chart.defaults.font.family = "'Noto Sans JP', sans-serif";
  Chart.defaults.font.size = 11;

  // 月次推移グラフ（折れ線）- 年次モードのみ
  <% if @view_mode == 'yearly' %>
  const monthLabels = <%= raw month_labels.to_json %>;
  const deptSeries = <%= raw dept_series.to_json %>;
  const monthlyTrendCanvas = document.getElementById('monthlyTrendChart');
  if (monthlyTrendCanvas) {
    new Chart(monthlyTrendCanvas, {
      type: 'line',
      data: {
        labels: monthLabels,
        datasets: deptSeries.map(s => ({
          label: s.name,
          data: s.data.map(v => Math.round(v / 10000)),
          borderColor: s.color,
          backgroundColor: s.color + '20',
          borderWidth: 2,
          tension: 0.3,
          fill: false
        }))
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              callback: function(value) { return value.toLocaleString() + '万'; }
            }
          }
        },
        plugins: {
          tooltip: {
            callbacks: {
              label: function(context) {
                return context.dataset.label + ': ' + context.parsed.y.toLocaleString() + '万円';
              }
            }
          }
        }
      }
    });
  }
  <% end %>

  // 部門別構成比（ドーナツ）
  const pieLabels = <%= raw pie_labels.to_json %>;
  const pieData = <%= raw pie_data.to_json %>;
  const pieColors = <%= raw pie_colors.to_json %>;

  new Chart(document.getElementById('deptPieChart'), {
    type: 'doughnut',
    data: {
      labels: pieLabels,
      datasets: [{
        data: pieData,
        backgroundColor: pieColors
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'right',
          labels: { boxWidth: 12, padding: 8, font: { size: 10 } }
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              const total = context.dataset.data.reduce((a, b) => a + b, 0);
              const pct = ((context.parsed / total) * 100).toFixed(1);
              return context.label + ': ' + context.parsed.toLocaleString() + '万円 (' + pct + '%)';
            }
          }
        }
      }
    }
  });

  // 部門間比較（棒グラフ）
  const compLabels = <%= raw comparison_labels.to_json %>;
  const currentData = <%= raw current_data.to_json %>;
  const prevData = <%= raw prev_data.to_json %>;
  const isMonthlyMode = <%= @view_mode == 'monthly' %>;

  new Chart(document.getElementById('deptComparisonChart'), {
    type: 'bar',
    data: {
      labels: compLabels,
      datasets: [
        {
          label: isMonthlyMode ? '当月' : '当期',
          data: currentData,
          backgroundColor: 'rgba(59, 130, 246, 0.8)',
          borderColor: 'rgb(59, 130, 246)',
          borderWidth: 1
        },
        {
          label: isMonthlyMode ? '前月' : '前期',
          data: prevData,
          backgroundColor: 'rgba(156, 163, 175, 0.6)',
          borderColor: 'rgb(156, 163, 175)',
          borderWidth: 1
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      indexAxis: 'y',
      scales: {
        x: {
          beginAtZero: true,
          ticks: {
            callback: function(value) { return value.toLocaleString() + '万'; }
          }
        }
      },
      plugins: {
        tooltip: {
          callbacks: {
            label: function(context) {
              return context.dataset.label + ': ' + context.parsed.x.toLocaleString() + '万円';
            }
          }
        }
      }
    }
  });

  // 取引先別構成比（ドーナツ）
  const vendorLabels = <%= raw vendor_labels.to_json %>;
  const vendorData = <%= raw vendor_data.to_json %>;
  const vendorColors = <%= raw vendor_chart_colors.to_json %>;

  const vendorCanvas = document.getElementById('vendorPieChart');
  if (vendorCanvas && vendorLabels.length > 0) {
    new Chart(vendorCanvas, {
      type: 'doughnut',
      data: {
        labels: vendorLabels,
        datasets: [{
          data: vendorData,
          backgroundColor: vendorColors.slice(0, vendorLabels.length)
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'right',
            labels: { boxWidth: 12, padding: 6, font: { size: 9 } }
          },
          tooltip: {
            callbacks: {
              label: function(context) {
                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                const pct = ((context.parsed / total) * 100).toFixed(1);
                return context.label + ': ' + context.parsed.toLocaleString() + '万円 (' + pct + '%)';
              }
            }
          }
        }
      }
    });
  }
});
</script>
