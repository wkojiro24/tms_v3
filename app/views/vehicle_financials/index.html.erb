<% content_for :title, "車両収支グリッド" %>
<% content_for :section_label, "車両" %>

<div class="vehicle-financials-container container-fluid px-4 py-3"
     data-controller="vehicle-financials"
     <% if @breakdown_data.present? %>data-vehicle-financials-breakdown-value='<%= @breakdown_data.to_json %>'<% end %>>

  <section class="card vehicle-financials-filters mb-3">
    <div class="card-body">
      <%= form_with url: vehicle_financials_path, method: :get, local: true, id: "vehicle-financials-form", data: { vehicle_financials_target: "form" } do |f| %>

        <%# === 表示モード選択 === %>
        <div class="mb-3">
          <label class="form-label small fw-semibold mb-2">表示モード</label>
          <div class="btn-group" role="group" aria-label="表示モード">
            <% view_mode = params[:view_mode] || "monthly" %>
            <input type="radio" class="btn-check" name="view_mode" id="view-mode-monthly" value="monthly" <%= "checked" if view_mode == "monthly" %> data-action="change->vehicle-financials#changeMode">
            <label class="btn btn-outline-primary btn-sm" for="view-mode-monthly">月別表示</label>

            <input type="radio" class="btn-check" name="view_mode" id="view-mode-term" value="term" <%= "checked" if view_mode == "term" %> data-action="change->vehicle-financials#changeMode">
            <label class="btn btn-outline-primary btn-sm" for="view-mode-term">期比較</label>

            <input type="radio" class="btn-check" name="view_mode" id="view-mode-custom" value="custom" <%= "checked" if view_mode == "custom" %> data-action="change->vehicle-financials#changeMode">
            <label class="btn btn-outline-primary btn-sm" for="view-mode-custom">カスタム期間</label>
          </div>
        </div>

        <div class="row gy-3 gx-3 align-items-end">

          <%# === 月別表示モード === %>
          <div class="col-12" data-vehicle-financials-target="modePanel" data-mode="monthly" <%= "style=display:none" unless view_mode == "monthly" %>>
            <div class="row gy-3 gx-3 align-items-end">
              <div class="col-12">
                <label class="form-label small mb-1">期を選択</label>
                <div class="vehicle-financials-period-tabs" aria-label="期選択">
                  <% @period_groups.each do |period| %>
                    <input class="btn-check"
                           type="radio"
                           name="period"
                           id="period-<%= period[:key] %>"
                           value="<%= period[:key] %>"
                           <%= "checked" if @selected_period == period[:key] %>
                           data-action="change->vehicle-financials#selectPeriod">
                    <label class="btn btn-outline-secondary btn-sm <%= "active" if @selected_period == period[:key] %>" for="period-<%= period[:key] %>">
                      <%= period[:label] %>
                    </label>
                  <% end %>
                </div>
              </div>
              <div class="col-sm-4 col-lg-3">
                <label class="form-label small mb-1">表示単位</label>
                <div class="btn-group w-100" role="group">
                  <% aggregation = params[:aggregation] || "monthly" %>
                  <input type="radio" class="btn-check" name="aggregation" id="agg-monthly" value="monthly" <%= "checked" if aggregation == "monthly" %> data-action="change->vehicle-financials#autoSubmit">
                  <label class="btn btn-outline-secondary btn-sm" for="agg-monthly">月別</label>
                  <input type="radio" class="btn-check" name="aggregation" id="agg-yearly" value="yearly" <%= "checked" if aggregation == "yearly" %> data-action="change->vehicle-financials#autoSubmit">
                  <label class="btn btn-outline-secondary btn-sm" for="agg-yearly">年間</label>
                </div>
              </div>
              <% if (params[:aggregation] || "monthly") == "monthly" %>
                <div class="col-sm-4 col-lg-3">
                  <%= f.label :month, "対象月", class: "form-label small" %>
                  <%= f.select :month,
                               options_for_select(@period_months.map { |m| [m.strftime("%Y年%m月"), m.strftime("%Y-%m")] }, @selected_month&.strftime("%Y-%m")),
                               {},
                               class: "form-select form-select-sm", data: { action: "change->vehicle-financials#autoSubmit" } %>
                </div>
              <% end %>
            </div>
          </div>

          <%# === 期比較モード === %>
          <div class="col-12" data-vehicle-financials-target="modePanel" data-mode="term" <%= "style=display:none" unless view_mode == "term" %>>
            <div class="row gy-3 gx-3 align-items-end">
              <div class="col-sm-6 col-lg-3">
                <label class="form-label small">開始期</label>
                <%= f.select :start_term,
                             options_for_select(@period_groups.map { |p| [p[:label], p[:key]] }, params[:start_term]),
                             { include_blank: "選択してください" },
                             class: "form-select form-select-sm" %>
              </div>
              <div class="col-sm-6 col-lg-3">
                <label class="form-label small">終了期</label>
                <%= f.select :end_term,
                             options_for_select(@period_groups.map { |p| [p[:label], p[:key]] }, params[:end_term]),
                             { include_blank: "選択してください" },
                             class: "form-select form-select-sm" %>
              </div>
              <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">表示</button>
              </div>
            </div>
          </div>

          <%# === カスタム期間モード === %>
          <div class="col-12" data-vehicle-financials-target="modePanel" data-mode="custom" <%= "style=display:none" unless view_mode == "custom" %>>
            <div class="row gy-3 gx-3 align-items-end">
              <div class="col-sm-6 col-lg-3">
                <label class="form-label small">開始月</label>
                <%= f.select :start_month,
                             options_for_select(@month_options, @start_month&.strftime("%Y-%m")),
                             { include_blank: "選択してください" },
                             class: "form-select form-select-sm" %>
              </div>
              <div class="col-sm-6 col-lg-3">
                <label class="form-label small">終了月</label>
                <%= f.select :end_month,
                             options_for_select(@month_options, @end_month&.strftime("%Y-%m")),
                             { include_blank: "選択してください" },
                             class: "form-select form-select-sm" %>
              </div>
              <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">表示</button>
              </div>
            </div>
          </div>

          <%# === 共通フィルター === %>
          <div class="col-12 mt-3 pt-3 border-top">
            <div class="row gy-3 gx-3 align-items-end">
              <div class="col-sm-6 col-lg-3">
                <%= f.label :depot, "営業所", class: "form-label small" %>
                <%= f.select :depot,
                             options_for_select(@available_depots, @selected_depot),
                             { include_blank: "すべて" },
                             class: "form-select form-select-sm", data: { action: "change->vehicle-financials#autoSubmit" } %>
              </div>

              <div class="col-sm-6 col-lg-3">
                <%= f.label :shipper, "荷主", class: "form-label small" %>
                <%= f.select :shipper,
                             options_for_select(@available_shippers, @selected_shipper),
                             { include_blank: "すべて" },
                             class: "form-select form-select-sm", data: { action: "change->vehicle-financials#autoSubmit" } %>
              </div>

              <%# === 車両グループ選択 === %>
              <div class="col-sm-6 col-lg-3">
                <label class="form-label small">車両グループ</label>
                <% group_options = @vehicle_groups.group_by(&:group_type).flat_map do |type, groups|
                     type_label = VehicleGroup.new(group_type: type).group_type_label
                     groups.map { |g| ["#{type_label} / #{g.name} (#{g.vehicle_codes&.size || 0}台)", g.id] }
                   end %>
                <%= f.select :vehicle_group_id,
                             options_for_select(group_options, @selected_vehicle_group_id),
                             { include_blank: "グループを選択..." },
                             class: "form-select form-select-sm", data: { action: "change->vehicle-financials#autoSubmit" } %>
                <% if @vehicle_groups.blank? %>
                  <small class="text-muted">
                    <%= link_to "グループを作成", admin_vehicle_groups_path, target: "_blank" %>
                  </small>
                <% end %>
              </div>

              <div class="col-sm-6 col-lg-3">
                <label class="form-label small">または車両を個別選択</label>
                <div class="d-flex gap-2 align-items-start">
                  <div class="flex-grow-1">
                    <div class="input-group input-group-sm">
                      <%= f.select :vehicle_codes,
                                   options_for_select(@available_vehicle_codes&.map { |c| [c, c] } || [], @selected_vehicle_group_id.blank? ? Array(params[:vehicle_codes]) : []),
                                   { include_blank: false },
                                   { multiple: true, class: "form-select form-select-sm", id: "vehicle-codes-select", size: 3, data: { vehicle_financials_target: "vehicleSelect" }, disabled: @selected_vehicle_group_id.present? } %>
                    </div>
                  </div>
                  <div class="d-flex flex-column gap-1">
                    <button type="submit" class="btn btn-primary btn-sm">適用</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" title="選択をクリア" data-action="click->vehicle-financials#clearVehicles">クリア</button>
                  </div>
                </div>
              </div>
            </div>

            <%# === 選択中の車両情報 === %>
            <% if @selected_vehicle_group.present? %>
              <div class="mt-3 p-2 bg-light rounded">
                <div class="d-flex align-items-center gap-2">
                  <span class="badge bg-primary"><%= @selected_vehicle_group.name %></span>
                  <span class="badge bg-secondary"><%= @selected_vehicle_group.vehicle_codes&.size || 0 %>台</span>
                  <span class="text-muted small">
                    <%= @selected_vehicle_group.vehicle_codes&.first(8)&.join(", ") %><%= ", ..." if (@selected_vehicle_group.vehicle_codes&.size || 0) > 8 %>
                  </span>
                </div>
              </div>
            <% elsif @selected_vehicle_codes.present? %>
              <div class="mt-3 p-2 bg-light rounded">
                <span class="badge bg-info"><%= @selected_vehicle_codes.size %>台選択中</span>
                <span class="text-muted small"><%= @selected_vehicle_codes.first(5).join(", ") %><%= ", ..." if @selected_vehicle_codes.size > 5 %></span>
              </div>
            <% end %>
          </div>

        </div>
      <% end %>
    </div>
  </section>

  <div class="vehicle-financials-actions mb-3 text-end">
    <% if @rows.present? %>
      <%= link_to vehicle_financials_path(vehicle_financial_query(format: :xlsx)), class: "btn btn-outline-success btn-sm" do %>
        <i class="bi bi-file-earmark-excel"></i> Excelダウンロード
      <% end %>
    <% end %>
    <button type="button"
            class="btn btn-outline-secondary btn-sm ms-2"
            data-fullscreen-target=".vehicle-financials-container"
            data-action="click->vehicle-financials#toggleFullscreen">
      フルスクリーン
    </button>
    <%= link_to(
          @yearly_view ? "年次サマリを閉じる" : "年次サマリ",
          vehicle_financials_path(vehicle_financial_query(view: (@yearly_view ? nil : "yearly"))),
          class: "btn btn-outline-primary btn-sm ms-2"
        ) %>
  </div>

  <% if @view_mode == "monthly" && @selected_month.blank? %>
    <div class="alert alert-info">車両別収支データがまだありません。</div>
  <% elsif @view_mode == "term" && @start_term.blank? && @end_term.blank? %>
    <div class="alert alert-info">開始期と終了期を選択して「表示」をクリックしてください。</div>
  <% elsif @view_mode == "custom" && @start_month.blank? && @end_month.blank? %>
    <div class="alert alert-info">開始月と終了月を選択して「表示」をクリックしてください。</div>
  <% elsif @header_window.blank? %>
    <div class="alert alert-warning">該当条件のデータが見つかりませんでした。</div>
  <% else %>
    <p class="text-muted small mb-2">
      表示範囲:
      <%= @total_groups.zero? ? "0" : "#{@start_index + 1}〜#{[@start_index + @visible_count, @total_groups].min}" %>
      / <%= @total_groups %> 件
    </p>

    <% if @prev_index || @next_index %>
      <div class="vehicle-grid-pager mb-3">
        <% if @prev_index %>
          <%= link_to "← 前の列", vehicle_financials_path(vehicle_financial_query(start: @prev_index)), class: "btn btn-outline-secondary btn-sm" %>
        <% end %>
        <span>列 <%= @start_index + 1 %> 〜 <%= [@start_index + @visible_count, @total_groups].min %></span>
        <% if @next_index %>
          <%= link_to "次の列 →", vehicle_financials_path(vehicle_financial_query(start: @next_index)), class: "btn btn-outline-secondary btn-sm" %>
        <% end %>
      </div>
    <% end %>

    <div class="table-responsive vehicle-financials-table-wrapper mb-5">
      <table class="table table-sm vehicle-financials-table font-scale-<%= @font_scale %>">
        <colgroup>
          <col class="vehicle-financials-section-col">
          <col class="vehicle-financials-item-col">
          <% @header_window.each do |_header| %>
            <col class="vehicle-financials-value-col">
          <% end %>
          <col class="vehicle-financials-summary-col">
          <col class="vehicle-financials-summary-col">
        </colgroup>
        <thead>
          <tr>
            <th class="vehicle-financials-sticky-col vehicle-financials-section-col text-start">区分</th>
            <th class="vehicle-financials-sticky-col vehicle-financials-item-col text-start">項目名</th>
            <% @header_window.each do |header| %>
              <% if header[:link_path] && header[:key].present? %>
                <th class="text-center vehicle-financials-header-col">
                  <%= link_to header[:title], vehicle_financial_path(header[:key], vehicle_financial_query(history_page: nil)), class: "vehicle-financials-col-link" %>
                </th>
              <% else %>
                <th class="text-center vehicle-financials-header-col"><%= header[:title] %></th>
              <% end %>
            <% end %>
            <th class="text-center vehicle-financials-header-col vehicle-financials-summary-col">合計</th>
            <th class="text-center vehicle-financials-header-col vehicle-financials-summary-col">平均</th>
          </tr>
        </thead>
        <tbody>
          <% current_section = nil %>
          <% @rows.each do |row| %>
            <% section_label = vehicle_financial_section_label(row) %>
            <% display_section = section_label.present? && section_label != current_section ? section_label : nil %>
            <% current_section = section_label if section_label.present? %>
            <% row_classes = ["vehicle-financials-row", vehicle_financial_row_class(row)].compact.join(" ") %>
            <% summary = vehicle_financial_row_summary(row) %>
            <tr class="<%= row_classes %>">
              <td class="vehicle-financials-sticky-col text-start"><%= display_section %></td>
              <th class="vehicle-financials-sticky-col text-start"><%= row[:label] %></th>
              <% row[:values].each_with_index do |value, idx| %>
                <% cell_state = row[:cell_states]&.at(idx) %>
                <% header = @header_window[idx] %>
                <% month_key = header[:key] if header %>
                <% has_breakdown = @group_monthly_view && @breakdown_data.present? && month_key && !month_key.to_s.start_with?("summary-", "placeholder-") %>
                <% if has_breakdown %>
                  <td class="text-end vehicle-financials-breakdown-cell"
                      data-breakdown-cell
                      data-breakdown-label="<%= row[:label] %>"
                      data-breakdown-month="<%= month_key %>"
                      data-action="click->vehicle-financials#showBreakdown"
                      title="クリックで車両別内訳を表示"><%= vehicle_financial_value(row[:label], value, cell_state: cell_state) %></td>
                <% else %>
                  <td class="text-end"><%= vehicle_financial_value(row[:label], value, cell_state: cell_state) %></td>
                <% end %>
              <% end %>
              <td class="text-end vehicle-financials-summary-cell"><%= vehicle_financial_value(row[:label], summary[:total]) %></td>
              <td class="text-end vehicle-financials-summary-cell"><%= vehicle_financial_value(row[:label], summary[:average]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  <% end %>

  <%# === グループ月別表示時のカテゴリ別アウトプット === %>
  <% if @group_monthly_view && @category_table.present? %>
    <section class="vehicle-financials-output mt-5">
      <div class="card card-lift">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <h2 class="h6 mb-1">表示カテゴリの選択</h2>
              <p class="text-muted small mb-0">
                表示したいカテゴリにチェックを入れてください。
                <% if current_user&.admin_role? %>
                  （<%= link_to "カテゴリ設定", admin_metric_categories_path, class: "text-decoration-underline" %>で行を追加・編集できます）
                <% end %>
              </p>
            </div>
            <%= link_to vehicle_financials_path(
                  format: :xlsx,
                  view_mode: @view_mode,
                  start_month: @start_month&.strftime("%Y-%m"),
                  end_month: @end_month&.strftime("%Y-%m"),
                  vehicle_group_id: @selected_vehicle_group_id,
                  category_ids: @selected_category_ids,
                  output_type: :category
                ),
                class: "btn btn-outline-success btn-sm" do %>
              <i class="bi bi-file-earmark-excel"></i> Excelダウンロード
            <% end %>
          </div>

          <%= form_with url: vehicle_financials_path, method: :get, local: true, class: "vehicle-output-form" do %>
            <%= hidden_field_tag :view_mode, @view_mode %>
            <%= hidden_field_tag :start_month, @start_month&.strftime("%Y-%m") %>
            <%= hidden_field_tag :end_month, @end_month&.strftime("%Y-%m") %>
            <%= hidden_field_tag :vehicle_group_id, @selected_vehicle_group_id %>
            <div class="d-flex flex-wrap gap-3 mb-3">
              <% Array(@metric_categories).each do |category| %>
                <% checkbox_id = "category-#{category.id}" %>
                <div class="form-check">
                  <%= check_box_tag "category_ids[]", category.id, @selected_category_ids.include?(category.id), id: checkbox_id, class: "form-check-input" %>
                  <%= label_tag checkbox_id, category.display_label, class: "form-check-label" %>
                </div>
              <% end %>
            </div>
            <button type="submit" class="btn btn-outline-primary btn-sm">反映</button>
          <% end %>

          <% if @category_table.item_rows.any? %>
            <div class="table-responsive vehicle-financials-table-wrapper mt-4">
              <% month_colspan = @category_table.column_count %>
              <table class="table table-sm vehicle-financials-table">
                <colgroup>
                  <col class="vehicle-financials-section-col">
                  <col class="vehicle-financials-item-col">
                  <% @category_headers.each do |_header| %>
                    <col class="vehicle-financials-value-col">
                  <% end %>
                  <col class="vehicle-financials-summary-col">
                  <col class="vehicle-financials-summary-col">
                </colgroup>
                <thead>
                  <tr>
                    <th class="vehicle-financials-sticky-col vehicle-financials-section-col text-start">カテゴリ</th>
                    <th class="vehicle-financials-sticky-col vehicle-financials-item-col text-start">項目名</th>
                    <% @category_headers.each do |header| %>
                      <th class="text-center vehicle-financials-header-col"><%= header[:title] %></th>
                    <% end %>
                    <th class="text-center vehicle-financials-header-col vehicle-financials-summary-col">合計</th>
                    <th class="text-center vehicle-financials-header-col vehicle-financials-summary-col">平均</th>
                  </tr>
                </thead>
                <tbody>
                  <% current_category_id = nil %>
                  <% @category_table.rows.each do |row| %>
                    <% next if row.type == :section %>
                    <% display_category = nil %>
                    <% if row.category&.id != current_category_id %>
                      <% current_category_id = row.category&.id %>
                      <% display_category = row.category&.display_label %>
                    <% end %>
                    <% summary = vehicle_financial_row_summary(row) %>
                    <tr class="vehicle-financials-row">
                      <td class="vehicle-financials-sticky-col text-start fw-semibold"><%= display_category %></td>
                      <th class="vehicle-financials-sticky-col vehicle-financials-item-col text-start"><%= row.label %></th>
                      <% row.values.each do |value| %>
                        <td class="text-end"><%= vehicle_financial_value(row.label, value) %></td>
                      <% end %>
                      <td class="text-end vehicle-financials-summary-cell"><%= vehicle_financial_value(row.label, summary[:total]) %></td>
                      <td class="text-end vehicle-financials-summary-cell"><%= vehicle_financial_value(row.label, summary[:average]) %></td>
                    </tr>
                  <% end %>
                  <% if @profit_check && @profit_check[:missing_labels].blank? %>
                    <% calc_row = { label: @profit_check[:calc_label], values: @profit_check[:calc_values] } %>
                    <% recorded_row = { label: @profit_check[:profit_label], values: @profit_check[:recorded_values] } %>
                    <% diff_row = { label: "差額(検算-損益)", values: @profit_check[:diff_values] } %>
                    <% [calc_row, recorded_row, diff_row].each do |row| %>
                      <% summary = vehicle_financial_row_summary(row) %>
                      <tr class="vehicle-financials-row vehicle-grid__row--grand">
                        <td class="vehicle-financials-sticky-col text-start" colspan="2"><%= row[:label] %></td>
                        <% row[:values].each do |value| %>
                          <td class="text-end"><%= vehicle_financial_value(row[:label], value) %></td>
                        <% end %>
                        <td class="text-end vehicle-financials-summary-cell"><%= vehicle_financial_value(row[:label], summary[:total]) %></td>
                        <td class="text-end vehicle-financials-summary-cell"><%= vehicle_financial_value(row[:label], summary[:average]) %></td>
                      </tr>
                    <% end %>
                  <% end %>
                  <tr class="vehicle-financials-row vehicle-grid__row--grand">
                    <td class="vehicle-financials-sticky-col text-start" colspan="2">合計</td>
                    <td colspan="<%= month_colspan %>"></td>
                    <td class="text-end fw-bold vehicle-financials-summary-cell"><%= vehicle_financial_value("合計", @category_table.total_values_sum) %></td>
                    <td class="text-end vehicle-financials-summary-cell"><%= vehicle_financial_value("合計", @category_table.total_average_value) %></td>
                  </tr>
                  <tr class="vehicle-financials-row vehicle-grid__row--grand">
                    <td class="vehicle-financials-sticky-col text-start" colspan="2">平均</td>
                    <td colspan="<%= month_colspan %>"></td>
                    <td class="text-end vehicle-financials-summary-cell"></td>
                    <td class="text-end vehicle-financials-summary-cell"><%= vehicle_financial_value("平均", @category_table.average_summary_value) %></td>
                  </tr>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted small mt-3">表示できるカテゴリがありません。カテゴリ設定を確認してください。</p>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <% if @yearly_view %>
    <div class="card card-lift mt-4">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h2 class="h6 mb-1">年次サマリ（損益合計）</h2>
            <p class="text-muted small mb-0">直近15期の主要指標だけを横並びで表示しています（輸送収入・損益など）。</p>
          </div>
          <%= link_to vehicle_financials_path(
                format: :xlsx,
                view_mode: @view_mode,
                view: "yearly",
                start_month: @start_month&.strftime("%Y-%m"),
                end_month: @end_month&.strftime("%Y-%m"),
                vehicle_group_id: @selected_vehicle_group_id,
                depot: @selected_depot,
                shipper: @selected_shipper,
                output_type: "yearly_summary"
              ), class: "btn btn-outline-success btn-sm" do %>
            <i class="bi bi-file-earmark-excel me-1"></i>Excelダウンロード
          <% end %>
        </div>
        <% if @yearly_headers.present? && @yearly_rows.present? %>
          <div class="table-responsive">
            <table class="table table-sm vehicle-financials-table">
              <colgroup>
                <col class="vehicle-financials-item-col">
                <% @yearly_headers.each do |_header| %>
                  <col class="vehicle-financials-summary-col">
                <% end %>
              </colgroup>
              <thead>
                <tr>
                  <th class="text-start">項目名</th>
                  <% @yearly_headers.each do |header| %>
                    <th class="text-center vehicle-financials-header-col vehicle-financials-summary-col"><%= header[:title] %></th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% current_section = nil %>
                <% @yearly_rows.each do |row| %>
                  <% section_label = vehicle_financial_section_label(row) %>
                  <% display_section = section_label.present? && section_label != current_section ? section_label : nil %>
                  <% current_section = section_label if section_label.present? %>
                  <% row_classes = ["vehicle-financials-row", vehicle_financial_row_class(row)].compact.join(" ") %>
                  <tr class="<%= row_classes %>">
                    <th class="vehicle-financials-sticky-col text-start">
                      <%= display_section.presence || row[:label] %>
                    </th>
                    <% row[:values].each do |value| %>
                      <td class="text-end vehicle-financials-summary-cell"><%= vehicle_financial_value(row[:label], value) %></td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-muted small mb-0">表示できる年次データがありません。</p>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
