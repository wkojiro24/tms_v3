// 0:00始まりの24時間タイムライン（1時間=40px）
// Turbo対応: 再宣言防止
if (typeof TIMELINE_START_HOUR === 'undefined') {
  var TIMELINE_START_HOUR = 0;
  var TIMELINE_PIXELS_PER_HOUR = 40;
}

function timeToPixels(timeStr) {
  if (!timeStr) return 0;
  const [hours, minutes] = timeStr.split(':').map(Number);
  const totalMinutes = (hours - TIMELINE_START_HOUR) * 60 + (minutes || 0);
  return Math.max(0, (totalMinutes / 60) * TIMELINE_PIXELS_PER_HOUR);
}

function updateCurrentTimeLine() {
  const now = new Date();
  const hours = now.getHours();
  const minutes = now.getMinutes();
  // 24時間表示なので常に表示
  const pixelPos = ((hours - TIMELINE_START_HOUR) * 60 + minutes) / 60 * TIMELINE_PIXELS_PER_HOUR;
  const line = document.getElementById('current-time-line');

  if (line) {
    line.style.left = (150 + pixelPos) + 'px'; // ラベル幅150pxに変更
    line.style.display = 'block';
  }
}

// モーダルインスタンスをキャッシュして高速表示
