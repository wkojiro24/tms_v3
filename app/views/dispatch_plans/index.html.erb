// デフォルトドライバーを編集（クリック時）
function editDefaultDriver(vehicleId) {
  const currentDriver = window.vehicleDefaultDrivers[vehicleId];
  const employees = Object.entries(window.employeeMap);

  // シンプルな選択プロンプト（本当はモーダルが良い）
  let options = ['0: 未設定（クリア）'];
  employees.forEach(([id, name]) => {
    options.push(`${id}: ${name}`);
  });

  const currentText = currentDriver?.name || '未設定';
  const input = prompt(`デフォルトドライバーを選択してください\n現在: ${currentText}\n\n選択肢:\n${options.join('\n')}\n\nIDを入力（0でクリア）:`);

  if (input === null) return; // キャンセル

  const selectedId = parseInt(input);
  if (isNaN(selectedId)) {
    alert('有効なIDを入力してください');
    return;
  }

  if (selectedId === 0) {
    // クリア
    updateDefaultDriver(vehicleId, null, null);
  } else {
    const selectedName = window.employeeMap[selectedId];
    if (!selectedName) {
      alert('無効なIDです');
      return;
    }
    updateDefaultDriver(vehicleId, selectedId, selectedName);
  }
}

// トースト表示
function showToast(message, type = 'info') {
  const bgClass = type === 'success' ? 'bg-success' : (type === 'error' ? 'bg-danger' : 'bg-info');
  const toast = document.createElement('div');
  toast.className = 'position-fixed bottom-0 end-0 p-3';
  toast.style.zIndex = '9999';
  toast.innerHTML = `
    <div class="toast show ${bgClass} text-white">
      <div class="toast-body"><i class="bi bi-check-circle"></i> ${message}</div>
    </div>
  `;
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 3000);
}

function renderTimelineBars() {
  // 既存のバーをクリア
  document.querySelectorAll('.timeline-bar').forEach(el => el.remove());

  // 現在の基準に応じてバーを生成
  window.existingData.forEach(assignment => {
    if (!assignment.scheduled_departure) return;

    let row;
    if (currentTimelineBasis === 'vehicle') {
      if (!assignment.vehicle_id) return;
      row = document.querySelector(`#timeline-rows-vehicle .timeline-bars[data-vehicle-id="${assignment.vehicle_id}"]`);
    } else {
      if (!assignment.employee_id) return;
      row = document.querySelector(`#timeline-rows-driver .timeline-bars[data-employee-id="${assignment.employee_id}"]`);
    }

    if (!row) return;

    const bar = createTimelineBar(assignment);
    row.appendChild(bar);
  });
}

function createTimelineBar(assignment) {
  const bar = document.createElement('div');
  bar.className = 'timeline-bar position-absolute rounded';
  bar.dataset.assignmentId = assignment.id;

  // 時間からピクセル位置を計算（0:00始まり、1時間=40px）
  const startPixels = timeToPixels(assignment.scheduled_departure);
  const endPixels = assignment.scheduled_arrival
    ? timeToPixels(assignment.scheduled_arrival)
    : startPixels + 80; // デフォルト2時間 (2 * 40px)

  const left = startPixels;
  const width = Math.max(endPixels - startPixels, 25); // 最小25px

  // ステータスと異常による色分け
  let bgClass = 'bar-pending'; // 未出発は淡いオレンジ
  let textColorClass = 'text-dark'; // 未出発は黒文字
  let hasAnomaly = assignment.has_anomaly || false;
  let isRelay = assignment.is_relay || false;
  let hasAlertFlag = assignment.alert_flag || false;

  if (assignment.status === 'completed') {
    bgClass = 'bg-success';
    textColorClass = 'text-white';
  } else if (assignment.status === 'in_progress') {
    bgClass = 'bg-primary';
    textColorClass = 'text-white';
  } else if (assignment.instruction === '休車') {
    bgClass = 'bg-secondary';
    textColorClass = 'text-white';
  }

  // 注意喚起フラグ、異常検知、乗り回しの場合は赤枠で強調
  let borderStyle = 'none';
  if (hasAlertFlag || hasAnomaly || isRelay) {
    borderStyle = '3px solid #dc3545'; // 赤枠
  }

  bar.className += ` ${bgClass}`;
  bar.style.cssText = `
    left: ${left}px;
    width: ${width}px;
    top: 6px;
    height: 36px;
    cursor: pointer;
    opacity: 0.95;
    z-index: 5;
    border: ${borderStyle};
  `;

  // バー内のテキスト（基準によって表示を変える）
  const destination = window.destinationMap[assignment.destination_location_id] || '';
  const employee = window.employeeMap[assignment.employee_id] || '';
  const vehicle = window.vehicleMap[assignment.vehicle_id] || '';

  let mainText = destination || assignment.instruction || '---';
  let subText = '';
  let alertIcon = '';

  // アラートアイコン
  if (hasAnomaly) {
    alertIcon = '<i class="bi bi-exclamation-triangle-fill text-warning me-1" title="通常と異なる配車"></i>';
  } else if (isRelay) {
    alertIcon = '<i class="bi bi-arrow-repeat text-white me-1" title="乗り回し"></i>';
  }

  if (currentTimelineBasis === 'vehicle') {
    // 車両基準: メイン=納品先、サブ=ドライバー名
    subText = employee;
  } else {
    // ドライバー基準: メイン=納品先、サブ=車両番号
    subText = vehicle ? `${vehicle}` : '';
  }

  bar.innerHTML = `
    <div class="bar-content px-1 py-0 ${textColorClass} small text-truncate" style="line-height: 1.1; pointer-events: none;">
      <div class="fw-semibold" style="font-size: 0.7rem;">${alertIcon}${mainText}</div>
      <div class="opacity-75" style="font-size: 0.6rem;">${subText}</div>
    </div>
    <div class="resize-handle resize-right" style="position: absolute; right: 0; top: 0; bottom: 0; width: 8px; cursor: ew-resize; background: rgba(0,0,0,0.15);"></div>
  `;

  // ドライバーをバーにドロップできるようにする
  bar.addEventListener('dragover', (e) => {
    e.preventDefault();
    e.stopPropagation();
    bar.classList.add('driver-drop-on-bar');
  });
  bar.addEventListener('dragleave', (e) => {
    bar.classList.remove('driver-drop-on-bar');
  });
  bar.addEventListener('drop', (e) => {
    e.preventDefault();
    e.stopPropagation();
    bar.classList.remove('driver-drop-on-bar');

    const type = e.dataTransfer.getData('type');
    if (type === 'driver') {
      const employeeId = e.dataTransfer.getData('employeeId');
      const employeeName = e.dataTransfer.getData('employeeName');
      assignDriverToAssignment(assignment.id, employeeId, employeeName);
    }
  });

  // ダブルクリックで編集モーダル
  bar.addEventListener('dblclick', (e) => {
    e.stopPropagation();
    openAssignmentModal(assignment);
  });

  // interact.jsでドラッグ＆リサイズを設定
  setupBarInteraction(bar, assignment);

  return bar;
}

// interact.jsを使ったバーのドラッグ・リサイズ設定
function setupBarInteraction(bar, assignment) {
  interact(bar)
    .draggable({
      inertia: false,
      autoScroll: true,
      listeners: {
        start(event) {
          const target = event.target;
          target.dataset.dragging = 'true';
          target.style.zIndex = '100';
          target.dataset.originalParent = target.parentElement.dataset.vehicleId;
          // 絶対位置で移動できるようにする
          const rect = target.getBoundingClientRect();
          target.dataset.startX = rect.left;
          target.dataset.startY = rect.top;
        },
        move(event) {
          const target = event.target;
          const x = (parseFloat(target.dataset.x) || parseFloat(target.style.left) || 0) + event.dx;
          const y = (parseFloat(target.dataset.y) || 0) + event.dy;
          target.style.left = `${x}px`;
          target.style.transform = `translateY(${y}px)`;
          target.dataset.x = x;
          target.dataset.y = y;

          // ドロップ先のハイライト
          highlightDropTarget(event.clientX, event.clientY);
        },
        end(event) {
          const target = event.target;
          target.dataset.dragging = 'false';
          target.style.zIndex = '5';
          target.style.transform = '';
          target.dataset.y = 0;

          // ドロップ先の車両行を検出
          const dropTarget = getDropTargetRow(event.clientX, event.clientY);
          clearDropHighlights();

          const newLeft = parseFloat(target.style.left) || 0;
          const newDeparture = pixelsToTime(newLeft);
          const width = parseFloat(target.style.width) || 80;
          const newArrival = pixelsToTime(newLeft + width);

          if (dropTarget && dropTarget.dataset.vehicleId != target.dataset.originalParent) {
            // 別の車両に移動
            const newVehicleId = dropTarget.dataset.vehicleId;
            moveAssignmentToVehicle(assignment.id, newVehicleId, newDeparture, newArrival);
          } else {
            // 同じ車両内での時間変更
            updateAssignmentTime(assignment.id, newDeparture, newArrival);
          }
        }
      }
    })
    .resizable({
      edges: { right: '.resize-right' },
      modifiers: [
        interact.modifiers.restrictSize({
          min: { width: 20 }
        })
      ],
      listeners: {
        move(event) {
          const target = event.target;
          target.style.width = `${event.rect.width}px`;
        },
        end(event) {
          const target = event.target;
          const left = parseFloat(target.style.left) || 0;
          const width = event.rect.width;

          const newDeparture = pixelsToTime(left);
          const newArrival = pixelsToTime(left + width);

          updateAssignmentTime(assignment.id, newDeparture, newArrival);
        }
      }
    });
}

// ドロップ先の車両行をハイライト
function highlightDropTarget(clientX, clientY) {
  clearDropHighlights();
  const row = getDropTargetRow(clientX, clientY);
  if (row) {
    row.classList.add('bar-drop-target');
  }
}

// ハイライトをクリア
function clearDropHighlights() {
  document.querySelectorAll('.bar-drop-target').forEach(el => el.classList.remove('bar-drop-target'));
}

// ドロップ先の車両行を取得
function getDropTargetRow(clientX, clientY) {
  const rows = document.querySelectorAll('#timeline-rows-vehicle .timeline-bars');
  for (const row of rows) {
    const rect = row.getBoundingClientRect();
    if (clientY >= rect.top && clientY <= rect.bottom) {
      return row;
    }
  }
  return null;
}

// 配車を別の車両に移動
function moveAssignmentToVehicle(assignmentId, newVehicleId, departure, arrival) {
  const dateStr = getDateInputValue();

  // 新しい車両のデフォルトドライバーを取得
  const defaultDriver = window.vehicleDefaultDrivers[newVehicleId];

  fetch('/dispatch_plans/batch_update?date=' + dateStr, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
    },
    body: JSON.stringify({
      assignments: [{
        id: assignmentId,
        vehicle_id: newVehicleId,
        employee_id: defaultDriver?.id || null, // 新しい車両のデフォルトドライバーを適用
        scheduled_departure: departure,
        scheduled_arrival: arrival
      }]
    })
  })
  .then(response => response.json())
  .then(result => {
    if (result.success) {
      showToast('配車を移動しました', 'success');
      reloadKeepingView();
    } else {
      alert('配車の移動に失敗しました');
      reloadKeepingView();
    }
  })
  .catch(error => {
    console.error('Error:', error);
    reloadKeepingView();
  });
}

