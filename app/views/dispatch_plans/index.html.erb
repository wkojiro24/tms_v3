function saveAssignmentFromModal() {
  console.log('saveAssignmentFromModal called');
  try {
    const dateStr = getDateInputValue();
    const assignmentIdValue = document.getElementById('modal-assignment-id').value;
    const assignmentId = assignmentIdValue && assignmentIdValue.trim() !== '' ? parseInt(assignmentIdValue) : null;
    const vehicleIdValue = document.getElementById('modal-vehicle-id').value;
    const vehicleId = vehicleIdValue && vehicleIdValue.trim() !== '' ? parseInt(vehicleIdValue) : null;
    const employeeIdValue = document.getElementById('modal-employee').value;
    const employeeId = employeeIdValue && employeeIdValue.trim() !== '' ? parseInt(employeeIdValue) : null;
    const destinationIdValue = document.getElementById('modal-destination').value;
    const destinationId = destinationIdValue && destinationIdValue.trim() !== '' ? parseInt(destinationIdValue) : null;

    // alert_flag要素の存在確認
    const alertFlagEl = document.getElementById('modal-alert-flag');
    console.log('alert_flag element:', alertFlagEl);
    const alertFlag = alertFlagEl ? alertFlagEl.checked : false;

    console.log('Saving assignment:', { id: assignmentId, vehicle_id: vehicleId, employee_id: employeeId, date: dateStr, alert_flag: alertFlag });

    const assignment = {
      id: assignmentId,
      vehicle_id: vehicleId,
      employee_id: employeeId,
      scheduled_departure: document.getElementById('modal-departure').value || null,
      scheduled_arrival: document.getElementById('modal-arrival').value || null,
      destination_location_id: destinationId,
      product_name: document.getElementById('modal-product').value || null,
      instruction: document.getElementById('modal-instruction').value || null,
      alert_flag: alertFlag,
      sequence: 1,
      status: 'pending'
    };

  fetch('/dispatch_plans/batch_update?date=' + dateStr, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
    },
    body: JSON.stringify({ assignments: [assignment] })
  })
  .then(response => response.json())
  .then(result => {
    console.log('Save result:', result);
    if (result.success) {
      bootstrap.Modal.getInstance(document.getElementById('assignmentModal')).hide();
      // ページを確実にリロード - 日付とデポを維持
      const depotFilter = document.getElementById('depot-filter-inline');
      const depot = depotFilter ? depotFilter.value : '';
      let reloadUrl = '/dispatch?date=' + dateStr + '&view=' + currentView;
      if (depot) reloadUrl += '&depot=' + encodeURIComponent(depot);
      window.location.href = reloadUrl;
    } else {
      alert('保存に失敗しました: ' + (result.errors || []).map(e => e.errors || e).join(', '));
    }
  })
  .catch(err => {
    console.error('Fetch error:', err);
    alert('通信エラーが発生しました: ' + err.message);
  });
  } catch (e) {
    console.error('saveAssignmentFromModal error:', e);
    alert('エラーが発生しました: ' + e.message);
  }
}

function deleteAssignmentFromModal() {
  // 重複実行防止
  if (window.isDeleting) return;

  const assignmentId = document.getElementById('modal-assignment-id').value;
  if (!assignmentId) {
    alert('削除対象がありません');
    return;
  }

  if (!confirm('この配車を削除しますか？')) return;

  window.isDeleting = true;

  fetch('/dispatch_plans/destroy_assignment?assignment_id=' + assignmentId, {
    method: 'DELETE',
    headers: {
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
    }
  })
  .then(response => {
    if (response.ok || response.status === 204) {
      const modal = bootstrap.Modal.getInstance(document.getElementById('assignmentModal'));
      if (modal) modal.hide();
      // 通常のページ遷移でリロード（Turboを使わない）
      const url = new URL(window.location.href);
      url.searchParams.set('view', currentView);
      window.location.href = url.toString();
    } else {
      window.isDeleting = false;
      alert('削除に失敗しました');
    }
  })
  .catch(error => {
    window.isDeleting = false;
    console.error('Error:', error);
    alert('削除中にエラーが発生しました');
  });
}

// ===============================
// 共通関数
// ===============================
function changeDate(dateStr) {
  const depotFilter = document.getElementById('depot-filter-inline');
  const depot = depotFilter ? depotFilter.value : '';
  let url = '/dispatch?date=' + dateStr;
  if (depot) url += '&depot=' + encodeURIComponent(depot);
  // 現在のビューを維持
  url += '&view=' + currentView;
  window.location.href = url;
}

function changeDepot(depot) {
  const dateStr = getDateInputValue();
  let url = '/dispatch?date=' + dateStr;
  if (depot) url += '&depot=' + encodeURIComponent(depot);
  // 現在のビューを維持
  url += '&view=' + currentView;
  window.location.href = url;
}

// 現在表示されているビューの日付入力フィールドを取得
function getDateInputValue() {
  const timelineDateInput = document.getElementById('dispatch-date');
  const tableDateInput = document.getElementById('dispatch-date-table');
  // どちらかの値を返す（両方同じ日付）
  return (timelineDateInput && timelineDateInput.value) || (tableDateInput && tableDateInput.value) || new Date().toISOString().split('T')[0];
}

function goToPreviousDay() {
  const currentDate = new Date(getDateInputValue());
  currentDate.setDate(currentDate.getDate() - 1);
  changeDate(currentDate.toISOString().split('T')[0]);
}

function goToNextDay() {
  const currentDate = new Date(getDateInputValue());
  currentDate.setDate(currentDate.getDate() + 1);
  changeDate(currentDate.toISOString().split('T')[0]);
}

function goToToday() {
  const today = new Date().toISOString().split('T')[0];
  changeDate(today);
}

// ===============================
// 確定（ロック）機能
// ===============================
function confirmDispatchPlan() {
  if (!confirm('配車計画を確定しますか？確定後は編集がロックされます。')) return;

  const dateStr = document.getElementById('dispatch-date').value;

  fetch('/dispatch_plans/confirm?date=' + dateStr, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
    }
  })
  .then(response => response.json())
  .then(result => {
    if (result.success) {
      location.reload();
    } else {
      alert('確定に失敗しました: ' + (result.error || ''));
    }
  });
}

function unlockDispatchPlan() {
  const reason = prompt('ロック解除の理由を入力してください（必須）:');
  if (!reason || reason.trim() === '') {
    alert('理由が必要です');
    return;
  }

  const dateStr = document.getElementById('dispatch-date').value;

  fetch('/dispatch_plans/unlock?date=' + dateStr, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
    },
    body: JSON.stringify({ reason: reason })
  })
  .then(response => response.json())
  .then(result => {
    if (result.success) {
      location.reload();
    } else {
      alert('解除に失敗しました: ' + (result.error || ''));
    }
  });
}

function saveDispatchPlan() {
  if (currentView === 'table') {
    saveFromTableView();
  } else {
    // タイムラインからの保存は個別モーダルで行う
    alert('タイムライン表示では、バーをクリックして個別に編集・保存してください。');
  }
}

function saveFromTableView() {
  const hot = window.dispatchHot;
  const data = hot.getData();
  const dateStr = document.getElementById('dispatch-date').value;

  const assignments = data
    .filter(row => row[1] && row[1].trim() !== '')
    .map(row => ({
      id: row[0],
      vehicle_id: window.vehicleLabelToId[row[1]],
      employee_id: window.employeeLabelToId[row[2]],
      scheduled_departure: row[3],
      scheduled_arrival: row[4],
      destination_location_id: window.destinationLabelToId[row[5]],
      product_name: row[6],
      instruction: row[7],
      route_instruction: row[8],
      status: row[9] || 'pending',
      sequence: 1
    }));

  fetch('/dispatch_plans/batch_update?date=' + dateStr, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
    },
    body: JSON.stringify({ assignments: assignments })
  })
  .then(response => response.json())
  .then(result => {
    if (result.success) {
      window.dispatchDataChanged = false;
      const toast = document.createElement('div');
      toast.className = 'position-fixed bottom-0 end-0 p-3';
      toast.innerHTML = `
        <div class="toast show bg-success text-white">
          <div class="toast-body"><i class="bi bi-check-circle"></i> ${result.message}</div>
        </div>
      `;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
      setTimeout(() => location.reload(), 1000);
    } else {
      alert('保存に失敗しました: ' + (result.errors || []).map(e => e.errors).join(', '));
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('保存中にエラーが発生しました');
  });
}

window.addEventListener('beforeunload', function(e) {
  if (window.dispatchDataChanged) {
    e.preventDefault();
    e.returnValue = '';
  }
});

// 車両メモを保存
function saveVehicleMemo(input) {
  const vehicleId = input.dataset.vehicleId;
  const memo = input.value.trim();
  const dateStr = getDateInputValue();

  fetch('/dispatch_plans/save_vehicle_memo?date=' + dateStr, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
    },
    body: JSON.stringify({ vehicle_id: vehicleId, memo: memo })
  })
  .then(response => response.json())
  .then(result => {
    if (result.success) {
      // 成功したら入力フィールドの背景を一瞬緑にして保存を視覚化
      input.style.backgroundColor = '#d1e7dd';
      setTimeout(() => { input.style.backgroundColor = 'transparent'; }, 500);
    } else {
      alert('備考の保存に失敗しました');
    }
  })
  .catch(error => {
    console.error('Error:', error);
  });
}

// ===============================
// スクロール同期
// ===============================
function setupScrollSync() {
  const labelsScroll = document.getElementById('timeline-labels-scroll');
  const timelineScroll = document.getElementById('timeline-scroll-container');

  if (labelsScroll && timelineScroll) {
    // タイムラインの縦スクロールをラベルに同期
    timelineScroll.addEventListener('scroll', function() {
      labelsScroll.scrollTop = timelineScroll.scrollTop;
    });
    // ラベルの縦スクロールをタイムラインに同期
    labelsScroll.addEventListener('scroll', function() {
      timelineScroll.scrollTop = labelsScroll.scrollTop;
    });
  }
}

// 初期化時にスクロール同期をセットアップ
document.addEventListener('DOMContentLoaded', setupScrollSync);
document.addEventListener('turbo:load', setupScrollSync);

// ===============================
// 拡大表示（フルスクリーン）
// ===============================
var isFullscreen = false;

function toggleFullscreen() {
  const wrapper = document.getElementById('timeline-wrapper');
  const sidebar = document.getElementById('right-sidebar');
  const card = wrapper.closest('.card');

  if (!isFullscreen) {
    // フルスクリーンモードに
    card.style.position = 'fixed';
    card.style.top = '0';
    card.style.left = '0';
    card.style.right = '0';
    card.style.bottom = '0';
    card.style.zIndex = '9999';
    card.style.margin = '0';
    card.style.borderRadius = '0';
    wrapper.style.height = 'calc(100vh - 100px)';
    if (sidebar) sidebar.style.display = 'none';
    document.body.style.overflow = 'hidden';
    isFullscreen = true;
  } else {
    // 通常モードに戻す
    card.style.position = '';
    card.style.top = '';
    card.style.left = '';
    card.style.right = '';
    card.style.bottom = '';
    card.style.zIndex = '';
    card.style.margin = '';
    card.style.borderRadius = '';
    wrapper.style.height = '560px';
    if (sidebar) sidebar.style.display = '';
    document.body.style.overflow = '';
    isFullscreen = false;
  }
}

// ESCキーでフルスクリーン解除
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape' && isFullscreen) {
    toggleFullscreen();
  }
});

// ===============================
// 共有URL発行
// ===============================
function generateShareUrl() {
  const dateStr = getDateInputValue();
  const depotFilter = document.getElementById('depot-filter-inline');
  const depot = depotFilter ? depotFilter.value : '';

  fetch('/dispatch_plans/generate_share_token?date=' + dateStr, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
    },
    body: JSON.stringify({ depot: depot })
  })
  .then(response => response.json())
  .then(result => {
    if (result.success) {
      // 共有URLをコピー
      const shareUrl = result.share_url;
      navigator.clipboard.writeText(shareUrl).then(() => {
        alert('共有URLをクリップボードにコピーしました！\n\n' + shareUrl + '\n\n有効期限: ' + result.expires_at);
      }).catch(() => {
        // クリップボードが使えない場合はプロンプトで表示
        prompt('共有URLをコピーしてください:\n有効期限: ' + result.expires_at, shareUrl);
      });
    } else {
      alert('共有URLの発行に失敗しました: ' + (result.error || ''));
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('エラーが発生しました');
  });
}
</script>

