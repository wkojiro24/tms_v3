<%= form_with(model: [vehicle, maintenance_event], local: true) do |f| %>
  <% if maintenance_event.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% maintenance_event.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= render "vehicles/maintenance_events/form_fields", f: f %>

  <div class="mt-3 text-end">
    <%= f.submit(maintenance_event.new_record? ? "登録する" : "更新する", class: "btn btn-primary") %>
  </div>
<% end %>
