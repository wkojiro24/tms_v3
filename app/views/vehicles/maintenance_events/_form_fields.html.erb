<div class="mb-3">
  <%= f.label :category, "メンテナンス種別", class: "form-label" %>
  <% categories = @maintenance_categories || MaintenanceCategory.order(:key) %>
  <% options = categories.map { |c| [maintenance_category_label(c.key), c.key] } + [["その他", "other"]] %>
  <%= f.select :category,
               options_for_select(options, f.object.category),
               { include_blank: "選択してください" },
               class: "form-select" %>
</div>

<div class="row g-3">
  <div class="col-md-6">
    <%= f.label :start_at, "予定日 / 実施日（開始）", class: "form-label" %>
    <%= f.datetime_local_field :start_at, class: "form-control" %>
  </div>
  <div class="col-md-6">
    <%= f.label :end_at, "終了", class: "form-label" %>
    <%= f.datetime_local_field :end_at, class: "form-control" %>
  </div>
</div>

<div class="mb-3 mt-3">
  <%= f.label :status, "ステータス", class: "form-label" %>
  <%= f.select :status,
               [["予定", "scheduled"], ["完了", "done"], ["キャンセル", "canceled"]],
               {},
               class: "form-select" %>
</div>

<div class="mb-3">
  <%= f.label :notes, "内容メモ", class: "form-label" %>
  <%= f.text_area :notes, rows: 3, class: "form-control" %>
</div>

<div class="row g-3">
  <div class="col-md-6">
    <%= f.label :repair_location, "修理箇所", class: "form-label" %>
    <%= f.text_field :repair_location, class: "form-control" %>
  </div>
  <div class="col-md-6">
    <%= f.label :vendor_name, "依頼先", class: "form-label" %>
    <%= f.text_field :vendor_name, class: "form-control" %>
  </div>
</div>

<div class="row g-3 mt-1">
  <div class="col-md-6">
    <%= f.label :estimated_cost, "概算費用 (円)", class: "form-label" %>
    <%= f.number_field :estimated_cost, class: "form-control", step: 1000, min: 0 %>
  </div>
  <div class="col-md-6">
    <%= f.label :photos, "写真 (最大10枚)", class: "form-label" %>
    <%= f.file_field :photos, multiple: true, class: "form-control", accept: "image/*" %>
  </div>
</div>
